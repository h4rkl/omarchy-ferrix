     return create_android_wl_buffer(conn, metadata, handle);
 }
+/* Ferrix: vendor grallocs (e.g. the Pixel 9a's gchips mapper.pixel) without
+ * android_wlegl. A linear buffer's dma-buf goes to the compositor as-is
+ * (zwp_linux_dmabuf_v1, which software compositors can map); anything else
+ * (AFBC/AFRC, multi-plane) is copied into SHM by CPU lock each frame
+ * (update_shm_buffer_android). Plane geometry and the modifier come from the
+ * mapper's standard metadata, never from the private handle layout. */
+std::unique_ptr<buffer> create_buffer_android_dmabuf(wl_conn *conn, const buffer_metadata& metadata, buffer_handle_t handle) {
+    if (conn->dmabuf && handle && handle->numFds >= 1) {
+        auto &mapper = android::GraphicBufferMapper::get();
+        buffer_handle_t imported = nullptr;
+        if (mapper.importBufferNoValidate(handle, &imported) == android::OK && imported) {
+            uint64_t modifier = DRM_FORMAT_MOD_INVALID;
+            uint32_t fourcc = 0;
+            std::vector<android::ui::PlaneLayout> planes;
+            bool ok = mapper.getPixelFormatModifier(imported, &modifier) == android::OK &&
+                      mapper.getPixelFormatFourCC(imported, &fourcc) == android::OK &&
+                      mapper.getPlaneLayouts(imported, &planes) == android::OK &&
+                      planes.size() == 1 && modifier == DRM_FORMAT_MOD_LINEAR &&
+                      isFormatSupported(conn, fourcc);
+            if (ok) {
+                const auto &plane = planes[0];
+                auto buf = create_dmabuf_wl_buffer(conn, metadata, handle->data[0], fourcc,
+                                                   static_cast<int>(plane.strideInBytes),
+                                                   static_cast<int>(plane.offsetInBytes), modifier, handle);
+                mapper.freeBuffer(imported);
+                ALOGI("android buffer %ux%u fourcc=%.4s stride=%lld exported as linear dma-buf",
+                      metadata.width, metadata.height, (const char *)&fourcc, (long long)plane.strideInBytes);
+                return buf;
+            }
+            ALOGI("android buffer %ux%u modifier=0x%llx planes=%zu fourcc=0x%x: not a linear single-plane "
+                  "dma-buf the compositor takes; using CPU-copied SHM",
+                  metadata.width, metadata.height, (unsigned long long)modifier, planes.size(), fourcc);
+            mapper.freeBuffer(imported);
+        }
+    }
+    return create_shm_wl_buffer(conn, metadata, handle);
+}
