# Canonical host-side development profile for Google Pixel 9a tegu MP1.0.
#
# This is a shell environment fragment consumed by tools/pixel-9a/env.sh. It
# is deliberately not a pmOS guest environment and it is not the QEMU mock
# profile at targets/qemu-aarch64/profile.toml. Keep target identity,
# production backend choice, and relative artifact roots here so host tools
# do not each grow their own copies of those values.

FERRIX_PIXEL9A_PROFILE_SCHEMA=1
FERRIX_PIXEL9A_PROFILE_KIND=physical-host-dev

FERRIX_TARGET=google-pixel-9a-tegu-gxq96-mp1-0
FERRIX_EVIDENCE=physical:google-pixel-9a-tegu-gxq96-mp1-0
FERRIX_TARGET_KIND=physical
FERRIX_TARGET_CODENAME=tegu
FERRIX_TARGET_MODEL=GXQ96
FERRIX_TARGET_HARDWARE_REVISION=MP1.0

# Production Linux adapters. Mock and QEMU adapters are intentionally not
# selected by this profile.
FERRIX_BACKEND_MODE=native-linux
FERRIX_MOCK_BACKEND=disabled
FERRIX_NETWORK_BACKEND=networkmanager
FERRIX_TELEPHONY_BACKEND=modemmanager
FERRIX_BLUETOOTH_BACKEND=bluez
FERRIX_AUDIO_BACKEND=wireplumber
FERRIX_POWER_BACKEND=upower
FERRIX_DISPLAY_BACKEND=drm
FERRIX_INPUT_BACKEND=evdev

# The physical target uses a native Linux pmOS substrate. These are host-side
# selectors only; pmOS package files remain under the target's pmos/ tree.
FERRIX_PIXEL9A_SUBSTRATE=postmarketos
FERRIX_PIXEL9A_ANDROID_FRAMEWORK=disabled

# Paths are relative to the repository root. env.sh resolves them once and
# exports the target-specific paths plus the explicit per-workflow interfaces
# consumed by the host workflows. The compatibility roots remain separate from
# QEMU's target-specific subdirectory and are only used by older generic tools.
FERRIX_PIXEL9A_CACHE_RELATIVE=.cache/ferrix/pixel-9a
FERRIX_PIXEL9A_OUT_RELATIVE=out/pixel-9a
FERRIX_PIXEL9A_KERNEL_CACHE_RELATIVE=.cache/ferrix/pixel-9a/kernel
FERRIX_PIXEL9A_KERNEL_OUT_RELATIVE=out/pixel-9a/kernel/tegu
FERRIX_PIXEL9A_ROOTFS_OUT_RELATIVE=out/pixel-9a/rootfs/tegu
FERRIX_PIXEL9A_FIRMWARE_OUT_RELATIVE=out/pixel-9a/firmware/tegu
FERRIX_PIXEL9A_IMAGE_OUT_RELATIVE=out/pixel-9a/images/tegu

# Cargo's default physical product target. Product compilation is performed
# directly on a provisioned native Linux x86_64 host; macOS and alternate
# cross-compilation substitutes are intentionally not accepted for this path.
FERRIX_PIXEL9A_RUST_TARGET=aarch64-unknown-linux-musl
# Link the product against the target's musl userspace. Cargo's default `cc`
# would otherwise select the host x86_64 linker and fail only after a long
# dependency build. A provisioned host may override this with an equivalent
# target linker.
FERRIX_PIXEL9A_RUST_LINKER=aarch64-linux-musl-gcc

# Requirements are grouped by workflow so a read-only identity operation does
# not imply that a kernel build toolchain is installed. `check` without a group
# checks every group; `validate` checks only this profile's invariants.
FERRIX_PIXEL9A_HOST_OS=Linux
FERRIX_PIXEL9A_HOST_ARCH=x86_64
FERRIX_PIXEL9A_HOST_TOOLS_BUILD='awk avbtool bash basename bc bison cargo clang chmod cpio cp curl cut date depmod df dirname find flex git grep head ld.lld ln llvm-ar llvm-nm llvm-objcopy llvm-objdump llvm-readelf make mkdir mkbootimg mkdtboimg.py mktemp mke2fs mv od perl pkg-config pmbootstrap python3 readelf repo rm rustc sed sha256sum sha512sum sort stat tar tr unzip wc'
FERRIX_PIXEL9A_HOST_TOOLS_RECOVERY='adb awk cat curl cut date fastboot grep head mkdir mv rm sed sha256sum ssh tr unzip wc'
FERRIX_PIXEL9A_HOST_TOOLS_INSPECTION='awk basename cargo dirname grep mkdir rustc unzip wc'
FERRIX_PIXEL9A_HOST_TOOLS_FIRMWARE='awk cp debugfs dirname grep mkdir mktemp mv od sha256sum simg2img tr unzip wc'
