#!/sbin/openrc-run

[ -r /etc/ferrix/backends.env ] && . /etc/ferrix/backends.env
export FERRIX_TARGET FERRIX_EVIDENCE FERRIX_TELEPHONY_BACKEND

name="Exynos S5300 modem userspace"
description="Serves native-Linux S5300 boot, RFS, and GEMS channels"
command=/usr/sbin/exynos-modem
# Each backend gets its own explicit CLI. No modem service is in a runlevel;
# see s5300-cpif-integration.md.
case "${FERRIX_S5300_KERNEL_BACKEND:-}" in
	linux-google-tegu-wwan)
		supervisor=supervise-daemon
		# The reviewed exynos-modem CLI intentionally consumes the legacy kernel
		# endpoint /dev/umts_oem1 for its GEMS/OEM channel. The source-derived
		# s5300-channels.toml catalog expands the same OEM channel family as
		# oem_ipc0..oem_ipc7; it is metadata, not a request to invent a udev alias.
		# Keep this exact upstream CLI contract until a booted Tegu proves otherwise.
		command_args="--model 5300 --uecap-dir /vendor/firmware/uecapconfig --boot-dev /dev/umts_boot0 --rfs-dev /dev/umts_rfs0 --oem-gems-dev /dev/umts_oem1"
		respawn_delay=2
		;;
	google-kleaf-cpif)
		# Google Kleaf CPIF (patches 0001-0003): boot DT ch 241, RFS ch 41, and
		# OEM/GEMS ch 130 on oem_ipc1. No supervisor respawn: the daemon handles
		# CP recovery itself, and a daemon exit stays stopped until the next
		# manual preflight, arm, and start.
		command_args="--model 5300 --kernel-backend google-kleaf-cpif --uecap-dir /vendor/firmware/uecapconfig --boot-dev /dev/umts_boot0 --rfs-dev /dev/umts_rfs0 --oem-gems-dev /dev/oem_ipc1"
		command_background=yes
		pidfile=/run/exynos-modem.pid
		;;
	*)
		command_args=
		;;
esac
extra_commands="preflight provision"
extra_stopped_commands="arm"
description_preflight="Read-only google-kleaf-cpif checks; opens no CPIF node"
description_provision="Create the private /run/exynos-modem scratch directory only"
description_arm="Run the preflight, then allow exactly one manual start"

# The exact output of --print-config for the CPIF command_args above.
cpif_modem_config='kernel_backend=google-kleaf-cpif
boot_dev=/dev/umts_boot0
rfs_dev=/dev/umts_rfs0
oem_gems_dev=/dev/oem_ipc1
uecap_dir=/vendor/firmware/uecapconfig
scratch_dir=/run/exynos-modem
crash_dump_boot=disabled'

depend() {
	# The deptree must follow a backend change in backends.env.
	config /etc/ferrix/backends.env
	need ferrix-radio-firmware
	case "${FERRIX_S5300_KERNEL_BACKEND:-}" in
		linux-google-tegu-wwan)
			need ferrix-s5300-mounts
			;;
		*)
			# OpenRC starts a `need` before start_pre runs, so a manual CPIF
			# start (or a refused backend) would mount the per-unit sources
			# before any check or the one-use arm. `use` only orders; the
			# preflight requires the mounts to be started already.
			use ferrix-s5300-mounts
			;;
	esac
	after udev ferrix-s5300-mounts
	before sit-proxy modemmanager
}

wait_for_boot_channel() {
	# The s5300_modem node is created by the built-in kernel driver and then
	# named by udev.  OpenRC's `after udev` ordering does not guarantee that the
	# final character node is visible at this exact instant, so tolerate the
	# short probe/udev race while retaining the exact type and timeout gate.
	attempt=0
	while [ "$attempt" -lt 100 ]; do
		[ -c /dev/umts_boot0 ] && return 0
		sleep 0.1
		attempt=$((attempt + 1))
	done
	eerror "s5300_modem boot channel is missing or is not a character device"
	return 1
}

wwan_start_pre() {
	# The loader's boot/status ioctls here are for the community s5300_modem
	# transport.  WWAN SIT ports are intentionally *not* required here: the
	# pinned driver creates them only after the CP reaches ONLINE, while this
	# daemon must first boot it through the pre-ONLINE umts_boot0 channel.
	wait_for_boot_channel || return 1
	[ -f /usr/share/ferrix/pixel-9a/s5300-userspace-sources.toml ] || {
		eerror "S5300 userspace source manifest is missing"
		return 1
	}
	[ -d /vendor/firmware/uecapconfig ] || {
		eerror "external UECAP firmware directory is missing: /vendor/firmware/uecapconfig"
		return 1
	}
	[ -d /vendor/firmware/carrierconfig ] || {
		eerror "external carrier configuration directory is missing: /vendor/firmware/carrierconfig"
		return 1
	}
	[ -r /mnt/vendor/modem_img/images/default/modem.bin ] || {
		eerror "exact current-slot modem image is unavailable or unreadable"
		return 1
	}
	[ -r /mnt/vendor/efs/nv_normal.bin ] || {
		eerror "exact efs nv_normal.bin is unavailable or unreadable"
		return 1
	}
	[ -r /mnt/vendor/efs/nv_protected.bin ] || {
		eerror "exact efs nv_protected.bin is unavailable or unreadable"
		return 1
	}
	[ -r /mnt/vendor/persist/modem/cpsha ] || {
		eerror "exact persist modem/cpsha is unavailable or unreadable"
		return 1
	}
	# Private directory for the daemon's NV write sinks and crash records
	# (s5300-userspace-sources.toml scratch_directory). The daemon walks to it
	# without following symlinks and refuses it unless it is root-owned 0700.
	checkpath -d -m 0700 -o root:root /run/exynos-modem
}

# The checked-in google-kleaf-cpif checks; a missing library is a refusal.
load_cpif_checks() {
	[ "${FERRIX_S5300_KERNEL_BACKEND:-}" = google-kleaf-cpif ] || {
		eerror "this command is only for FERRIX_S5300_KERNEL_BACKEND=google-kleaf-cpif"
		return 1
	}
	[ -f /usr/lib/ferrix/s5300-cpif.sh ] && [ ! -L /usr/lib/ferrix/s5300-cpif.sh ] || {
		eerror "the S5300 CPIF check library is missing"
		return 1
	}
	. /usr/lib/ferrix/s5300-cpif.sh
}

run_cpif_preflight() {
	cpif_modem_preflight "$cpif_modem_config" $command_args
}

preflight() {
	load_cpif_checks || return 1
	ebegin "Checking the google-kleaf-cpif S5300 inputs (no CPIF node is opened)"
	run_cpif_preflight
	eend $?
}

provision() {
	load_cpif_checks || return 1
	ebegin "Provisioning the private /run/exynos-modem scratch directory"
	cpif_check_target && cpif_provision_scratch
	eend $?
}

arm() {
	load_cpif_checks || return 1
	ebegin "Arming one manual google-kleaf-cpif start"
	run_cpif_preflight && cpif_write_arm
	eend $?
}

start_pre() {
	command -v exynos-modem >/dev/null 2>&1 || {
		eerror "exynos-modem binary is missing"
		return 1
	}
	case "${FERRIX_S5300_KERNEL_BACKEND:-}" in
		linux-google-tegu-wwan)
			wwan_start_pre
			;;
		google-kleaf-cpif)
			# The token is consumed first, so a failed check still needs a new
			# preflight and arm before another attempt.
			load_cpif_checks && cpif_consume_arm && run_cpif_preflight
			;;
		*)
			eerror "exynos-modem refuses kernel backend '${FERRIX_S5300_KERNEL_BACKEND:-}'"
			return 1
			;;
	esac
}
