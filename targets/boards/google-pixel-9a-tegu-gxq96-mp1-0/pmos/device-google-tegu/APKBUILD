# Reference: https://postmarketos.org/devicepkg
pkgname=device-google-tegu
pkgdesc="Google Pixel 9a native Linux device package"
pkgver=1
pkgrel=0
maintainer="Omarchy Ferrix <maintainers@omarchy.invalid>"
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	dbus
	dbus-openrc
	eudev
	eudev-openrc
	networkmanager
	networkmanager-openrc
	modemmanager-samsung-sit
	modemmanager-samsung-sit-openrc
	exynos-modem
	bluez
	bluez-openrc
	pipewire
	pipewire-spa-bluez
	wireplumber
	upower
	seatd
	seatd-openrc
	libinput
	libseat
	libdrm
	pixman
	libxkbcommon
	mesa-gbm
	libgcc
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	10-ignore-aware-nmi.conf
	modules-initfs
	modules-initfs-radio
	boot-layout.toml
	firmware-policy.toml
	firmware-allowlist.tsv
	s5300-channels.toml
	s5300-userspace-sources.toml
	ferrix-backends.env
	ferrix-openrc.sh
	networkmanager-ferrix.conf
	modprobe-zram-gs.conf
	ferrix-core.initd
	ferrix-networkd.initd
	ferrix-telephonyd.initd
	ferrix-audio.initd
	ferrix-pipewire.initd
	ferrix-product.initd
	ferrix-android.initd
	ferrix-s5300-mounts.initd
	ferrix-radio-firmware.initd
	ferrix-bluetooth-uart.initd
	ferrix-contactsd.initd
	exynos-modem.initd
	sit-proxy.initd
	99-google-tegu-sit.rules
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/kernel-cmdline.conf \
		"$pkgdir"/usr/lib/kernel-cmdline.d/50-google-tegu.conf
	install -Dm644 "$srcdir"/10-ignore-aware-nmi.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/10-ignore-aware-nmi.conf
	install -Dm644 "$srcdir"/firmware-policy.toml \
		"$pkgdir"/usr/share/ferrix/pixel-9a/firmware-policy.toml
	install -Dm644 "$srcdir"/boot-layout.toml \
		"$pkgdir"/usr/share/ferrix/pixel-9a/boot-layout.toml
	install -Dm644 "$srcdir"/firmware-allowlist.tsv \
		"$pkgdir"/usr/share/ferrix/pixel-9a/firmware-allowlist.tsv
	install -Dm644 "$srcdir"/s5300-channels.toml \
		"$pkgdir"/usr/share/ferrix/pixel-9a/s5300-channels.toml
	install -Dm644 "$srcdir"/s5300-userspace-sources.toml \
		"$pkgdir"/usr/share/ferrix/pixel-9a/s5300-userspace-sources.toml
	install -Dm644 "$srcdir"/ferrix-backends.env \
		"$pkgdir"/etc/ferrix/backends.env

	install -Dm644 "$srcdir"/ferrix-openrc.sh \
		"$pkgdir"/usr/lib/ferrix/openrc.sh
	install -Dm644 "$srcdir"/networkmanager-ferrix.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/90-ferrix.conf
	install -Dm644 "$srcdir"/modprobe-zram-gs.conf \
		"$pkgdir"/etc/modprobe.d/ferrix-zram-gs.conf
	install -Dm755 "$srcdir"/ferrix-core.initd \
		"$pkgdir"/etc/init.d/ferrix-core
	install -Dm755 "$srcdir"/ferrix-networkd.initd \
		"$pkgdir"/etc/init.d/ferrix-networkd
	install -Dm755 "$srcdir"/ferrix-telephonyd.initd \
		"$pkgdir"/etc/init.d/ferrix-telephonyd
	install -Dm755 "$srcdir"/ferrix-audio.initd \
		"$pkgdir"/etc/init.d/ferrix-audio
	install -Dm755 "$srcdir"/ferrix-pipewire.initd \
		"$pkgdir"/etc/init.d/ferrix-pipewire
	install -Dm755 "$srcdir"/ferrix-product.initd \
		"$pkgdir"/etc/init.d/ferrix-product
	# Opt-in Android runtime bootstrap; linked into a runlevel only by the
	# dev composer's --android mode, never by this package.
	install -Dm755 "$srcdir"/ferrix-android.initd \
		"$pkgdir"/etc/init.d/ferrix-android
	install -Dm755 "$srcdir"/ferrix-s5300-mounts.initd \
		"$pkgdir"/etc/init.d/ferrix-s5300-mounts
	install -Dm755 "$srcdir"/ferrix-radio-firmware.initd \
		"$pkgdir"/etc/init.d/ferrix-radio-firmware
	install -Dm755 "$srcdir"/ferrix-bluetooth-uart.initd \
		"$pkgdir"/etc/init.d/ferrix-bluetooth-uart
	install -Dm755 "$srcdir"/ferrix-contactsd.initd \
		"$pkgdir"/etc/init.d/ferrix-contactsd
	install -Dm755 "$srcdir"/exynos-modem.initd \
		"$pkgdir"/etc/init.d/exynos-modem
	install -Dm755 "$srcdir"/sit-proxy.initd \
		"$pkgdir"/etc/init.d/sit-proxy
	install -Dm644 "$srcdir"/99-google-tegu-sit.rules \
		"$pkgdir"/usr/lib/udev/rules.d/99-google-tegu-sit.rules

	# Enable only services that have a stable OpenRC entry. PipeWire and
	# WirePlumber run through ferrix-audio because their Alpine packages are
	# user-session processes rather than system daemons. UPower is D-Bus
	# activated and deliberately has no OpenRC runlevel link on Alpine.
	mkdir -p "$pkgdir"/etc/runlevels/default
	for service in dbus udev ferrix-radio-firmware networkmanager ferrix-s5300-mounts exynos-modem sit-proxy modemmanager ferrix-bluetooth-uart bluetooth seatd ferrix-core ferrix-networkd ferrix-telephonyd ferrix-contactsd ferrix-pipewire ferrix-audio ferrix-product; do
		ln -sf /etc/init.d/$service "$pkgdir"/etc/runlevels/default/$service
	done
}

