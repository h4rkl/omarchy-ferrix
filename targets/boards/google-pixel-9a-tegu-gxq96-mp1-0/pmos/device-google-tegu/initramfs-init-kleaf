#!/bin/busybox sh

# Ferrix initramfs entrypoint for the Google Kleaf (GKI 6.1) development
# route on the exact tegu MP1.0 target. On GKI the UFS, clock, pinctrl, and
# watchdog drivers are vendor modules: the bootloader concatenates the
# source-built vendor_kernel_boot ramdisk (lib/modules/<release>/modules.load)
# ahead of this init_boot ramdisk, so load that list in Android's order first.
# Then mount the Linux userdata filesystem, load the system_dlkm and vendor_dlkm
# lists that tools/pixel-9a/dev-compose.py installed in the rootfs, and hand
# control to the postmarketOS init. No Android init, property service,
# framework, or HAL is used.
#
# Bring-up visibility: right after the watchdog, a USB CDC-ACM gadget exposes
# two serial ports to the host. The first streams the previous
# boot's pstore (ramoops) and the live kernel log; the second is a root shell.
# Failure paths hold for $hold_seconds before rebooting, so the bootloader's
# slot retry/fallback to the stock slot still applies.
#
# Automated bisection: with ferrix.checkpoint=STAGE on the kernel command line
# (dev-compose --checkpoint), /init reboots straight to bootloader Fastboot
# when it reaches STAGE (early, watchdog, gadget, modules, root, mounted, dlkm,
# switch), so
# a host sees how far boot got with nothing but `fastboot devices`.

bb=/bin/busybox
root_partlabel=userdata
hold_seconds=900
gadget=/sys/kernel/config/usb_gadget/ferrix

log() {
	$bb printf 'ferrix-init: %s\n' "$*" >/dev/kmsg 2>/dev/null ||
		$bb printf 'ferrix-init: %s\n' "$*" >/dev/console 2>/dev/null || :
}

# The bootloader appends module parameters (e.g. ufs_pixel_fips140.fips_first_lba=,
# exynos_drm.panel_name=) to the kernel command line. The kernel applies those
# only to built-in drivers; like Android's first-stage init, pass them to
# insmod for loadable modules. Values containing spaces are not supported.
module_args() {
	name=$(printf '%s' "${1##*/}" | $bb sed 's/\.ko$//' | $bb tr - _)
	$bb tr ' ' '\n' </proc/cmdline | $bb sed -n "s/^$name\.\([A-Za-z0-9_]*=[^\"]*\)$/\1/p" | $bb tr '\n' ' '
}

# Insert every module named in a Kleaf modules.load list (paths relative to
# the release directory) through the modprobe shim, which loads modules.dep
# dependencies first. A second and third pass catch probe-order stragglers.
load_list() {
	list=$1
	directory=$2
	[ -f "$list" ] || {
		log "$list: missing"
		return 0
	}
	pending=$($bb sed -e '/^#/d' -e '/^$/d' "$list")
	# ferrix.modules_limit=N (bisection) loads only the first N entries.
	[ -n "${3:-}" ] && pending=$(printf '%s\n' "$pending" | $bb head -n "$3")
	# ferrix.modules_skip=a,b (bisection): drop these module names.
	if [ -n "$modules_skip" ]; then
		kept=
		for module in $pending; do
			base=$(printf '%s' "${module##*/}" | $bb sed 's/\.ko$//' | $bb tr - _)
			case ",$modules_skip," in
				*",$base,"*) log "skipping $base" ;;
				*) kept="$kept $module" ;;
			esac
		done
		pending=$kept
	fi

	total=$(printf '%s\n' $pending | $bb wc -l)
	pass=0
	while [ -n "$pending" ] && [ "$pass" -lt 3 ]; do
		retry=
		for module in $pending; do
			# Already inserted (e.g. by the pKVM early loader): nothing to do.
			loaded=$(printf '%s' "${module##*/}" | $bb sed 's/\.ko$//' | $bb tr - _)
			$bb grep -q "^$loaded " /proc/modules && continue
			# Like Android's first-stage init, resolve modules.dep so a module's
			# dependencies (which may come later in the list) load first.
			/system/bin/modprobe -q -d "$directory" -- "$loaded" || retry="$retry $module"
		done
		pending=$retry
		pass=$((pass + 1))
	done
	failed=$(printf '%s' "$pending" | $bb wc -w)
	log "$list: total=$total failed=$failed"
	for module in $pending; do log "  not loaded: ${module##*/}"; done
}

gadget_bound=
console_pids=

start_usb_debug() {
	[ -z "$gadget_bound" ] || return 0
	# Only the USB device path, ahead of the full module list, so a module that
	# takes the SoC down later cannot hide the previous boot's pstore. The shim
	# pulls in each module's modules.dep dependencies.
	for module in exynos-pd_hsi0 eusb_repeater phy-exynos-usbdrd-eusb-super \
		dwc3-exynos-usb usb_psy max77759_helper bc_max77759 google_tcpci_shim \
		tcpci_max77759; do
		/system/bin/modprobe -q -- "$module" || log "usb debug: $module did not load"
	done
	$bb mdev -s 2>/dev/null || :
	$bb mount -t configfs configfs /sys/kernel/config 2>/dev/null || :
	waited=0
	while [ -z "$($bb ls /sys/class/udc 2>/dev/null)" ] && [ "$waited" -lt 15 ]; do
		$bb sleep 1
		waited=$((waited + 1))
	done
	udc=$($bb ls /sys/class/udc 2>/dev/null | $bb head -n 1)
	[ -n "$udc" ] || {
		log 'no USB device controller; debug gadget unavailable'
		return 0
	}
	$bb mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409" \
		"$gadget/functions/acm.log" "$gadget/functions/acm.shell" || return 0
	echo 0x1d6b >"$gadget/idVendor"
	echo 0x0104 >"$gadget/idProduct"
	echo 0x0200 >"$gadget/bcdUSB"
	# Interface Association class: macOS binds CDC-ACM in a composite gadget.
	echo 0xEF >"$gadget/bDeviceClass"
	echo 0x02 >"$gadget/bDeviceSubClass"
	echo 0x01 >"$gadget/bDeviceProtocol"
	echo Ferrix >"$gadget/strings/0x409/manufacturer"
	echo 'Ferrix tegu bring-up' >"$gadget/strings/0x409/product"
	echo ferrix-tegu >"$gadget/strings/0x409/serialnumber"
	echo 'log+shell' >"$gadget/configs/c.1/strings/0x409/configuration"
	$bb ln -s "$gadget/functions/acm.log" "$gadget/configs/c.1/"
	$bb ln -s "$gadget/functions/acm.shell" "$gadget/configs/c.1/"
	echo "$udc" >"$gadget/UDC" || {
		log "cannot bind debug gadget to $udc"
		return 0
	}
	gadget_bound=$udc
	log "debug gadget bound to $udc"
	$bb sleep 1
	$bb mdev -s 2>/dev/null || :
	# ttyGS0 = log, ttyGS1 = shell (function creation order).
	(
		while :; do
			{
				echo '=== ferrix: previous boot pstore ==='
				$bb cat /sys/fs/pstore/* 2>/dev/null
				echo '=== ferrix: live kernel log ==='
				$bb cat /dev/kmsg
			} >/dev/ttyGS0 2>/dev/null
			$bb sleep 2
		done
	) &
	console_pids="$console_pids $!"
	(
		while :; do
			$bb setsid $bb sh -c "exec $bb sh -i </dev/ttyGS1 >/dev/ttyGS1 2>&1"
			$bb sleep 1
		done
	) &
	console_pids="$console_pids $!"
}

# After switch_root these initramfs processes keep the old, emptied root and
# can no longer run anything; stop them and let the rootfs init own the ports.
handoff_usb_console() {
	[ -n "$gadget_bound" ] || return 0
	# shellcheck disable=SC2086
	[ -n "$console_pids" ] && $bb kill $console_pids 2>/dev/null
	$bb fuser -k /dev/ttyGS0 /dev/ttyGS1 >/dev/null 2>&1 || :
	inittab=/newroot/etc/inittab
	[ -f "$inittab" ] || return 0
	$bb grep -q '^ttyGS1::' "$inittab" || {
		echo '# Ferrix bring-up USB console (added by initramfs-init-kleaf)'
		echo 'ttyGS1::respawn:/sbin/getty -n -l /bin/sh 115200 ttyGS1'
		echo "::respawn:/bin/sh -c 'cat /dev/kmsg >/dev/ttyGS0'"
	} >>"$inittab"
	log 'USB console handed to the rootfs init (inittab ttyGS0/ttyGS1)'
}

checkpoint() {
	[ -n "$checkpoint_target" ] && [ "$1" = "$checkpoint_target" ] || return 0
	# ferrix.checkpoint_action=delay is a driver-free timing signal: each slot
	# attempt lasts ~30s longer when /init reaches STAGE. A Fastboot reboot needs
	# the pixel-reboot module to record the reboot mode, so load it first.
	if [ "$checkpoint_action" = delay ]; then
		log "checkpoint $1 reached; delaying 30s, then rebooting"
		$bb sleep 30
		$bb reboot -f
	fi
	# hold: stay at STAGE with the USB debug console up (end it from the shell).
	# Without a bound gadget nobody can use the hold, so reboot promptly instead.
	[ "$checkpoint_action" = hold ] && hold_then_reboot "checkpoint $1 reached"
	log "checkpoint $1 reached; rebooting to bootloader Fastboot"
	/system/bin/modprobe -q -- pixel-reboot || log 'pixel-reboot did not load'
	$bb sleep 1
	/bin/reboot-bootloader
	log 'reboot-bootloader returned; falling back to a plain reboot'
	$bb reboot -f
}

# Hold only when the USB console is up (someone can use it); otherwise reboot
# within seconds so the bootloader's retry/fallback to the stock slot happens
# quickly instead of leaving a black screen that looks like a dead phone.
hold_then_reboot() {
	if [ -n "$gadget_bound" ]; then
		log "$1; holding ${hold_seconds}s for USB debugging, then rebooting"
		$bb sleep "$hold_seconds"
	else
		log "$1; no USB console, rebooting"
		$bb sleep 3
	fi
	$bb reboot -f
}

# Print the block device for a GPT partition label, if it exists yet.
partition_device() {
	for candidate in /dev/disk/by-partlabel/$1 /dev/block/by-name/$1; do
		[ -b "$candidate" ] && {
			printf '%s\n' "$candidate"
			return 0
		}
	done
	for uevent in /sys/class/block/*/uevent; do
		[ -f "$uevent" ] || continue
		partname=$($bb sed -n 's/^PARTNAME=//p' "$uevent")
		[ "$partname" = "$1" ] || continue
		name=${uevent%/uevent}
		name=${name##*/}
		[ -b "/dev/$name" ] || continue
		printf '%s\n' "/dev/$name"
		return 0
	done
	return 1
}

find_root_device() {
	partition_device "$root_partlabel"
}

# Persist logs where the host can read them back with
# `just pixel-9a-dev-flash fetch vendor_boot_b OUT`: the unused tail of slot
# b's vendor_boot (the image is ~10 KiB of a 64 MiB partition and AVB
# verification is disabled). 48 MiB: the previous boot's pstore, written once.
# 56 MiB: this boot's dmesg, rewritten every two seconds. Never on slot a,
# which is the stock recovery slot.
# The bootloader passes the booted slot in bootconfig; fall back to the last
# androidboot.slot_suffix on the kernel command line.
running_slot() {
	value=$($bb sed -n 's/^[[:space:]]*androidboot\.slot_suffix[[:space:]]*=[[:space:]]*"*\([_ab]*\)"*[[:space:]]*$/\1/p' /proc/bootconfig 2>/dev/null | $bb tail -n 1)
	[ -n "$value" ] || value=$($bb tr ' ' '\n' </proc/cmdline | $bb sed -n 's/^androidboot\.slot_suffix=//p' | $bb tail -n 1)
	printf '%s\n' "$value"
}

start_flash_logger() {
	# This init_boot is only ever flashed to slot b; refuse anyway whenever the
	# bootloader reports slot a, so the stock recovery slot is never written.
	slot=$(running_slot)
	case "$slot" in
		*a*)
			log "flash logger disabled on slot '$slot'"
			return 0
			;;
	esac
	(
		device=
		while [ -z "$device" ]; do
			$bb mdev -s 2>/dev/null
			device=$(partition_device vendor_boot_b) || $bb sleep 1
		done
		log "flash logger writing to $device (vendor_boot_b tail)"
		{
			echo "FERRIX-PSTORE uptime=$($bb cat /proc/uptime) kernel=$release"
			for record in /sys/fs/pstore/*; do
				[ -f "$record" ] || continue
				echo "--- $record"
				$bb cat "$record"
			done
			echo 'FERRIX-PSTORE-END'
		} 2>/dev/null | $bb head -c 8388608 |
			$bb dd of="$device" bs=1048576 seek=48 conv=notrunc,fsync 2>/dev/null
		rounds=0
		while [ "$rounds" -lt 300 ]; do
			{
				echo "FERRIX-DMESG uptime=$($bb cat /proc/uptime)"
				$bb dmesg
				echo 'FERRIX-DMESG-END'
			} 2>/dev/null | $bb head -c 8388608 |
				$bb dd of="$device" bs=1048576 seek=56 conv=notrunc,fsync 2>/dev/null
			rounds=$((rounds + 1))
			$bb sleep 2
		done
	) &
}

$bb mount -t proc proc /proc 2>/dev/null || :
$bb mount -t sysfs sysfs /sys 2>/dev/null || :
checkpoint_target=$($bb sed -n 's/.*ferrix\.checkpoint=\([A-Za-z0-9]*\).*/\1/p' /proc/cmdline)
checkpoint_action=$($bb sed -n 's/.*ferrix\.checkpoint_action=\([A-Za-z0-9]*\).*/\1/p' /proc/cmdline)
checkpoint early
# The bootloader leaves the Exynos watchdog running; stock first-stage init
# loads s3c2410_wdt within a second or two, after which the watchdog core
# (CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED) keeps it fed until userspace opens it.
# Load it (and its four dependencies) before the long module list.
/system/bin/modprobe -q -- s3c2410_wdt || log 's3c2410_wdt did not load'
checkpoint watchdog
# GKI has no devtmpfs (Android's ueventd populates a tmpfs /dev), so do the
# same with busybox mdev on a tmpfs /dev. GKI also lacks CONFIG_UEVENT_HELPER,
# so there is no hotplug callback: rescan with `mdev -s` wherever this script
# waits for a device that a module creates.
$bb mount -t tmpfs -o mode=0755,size=64k tmpfs /dev 2>/dev/null || :
$bb mknod -m 600 /dev/console c 5 1 2>/dev/null || :
$bb mknod -m 644 /dev/kmsg c 1 11 2>/dev/null || :
$bb mknod -m 666 /dev/null c 1 3 2>/dev/null || :
$bb mdev -s 2>/dev/null || :
$bb mount -t pstore pstore /sys/fs/pstore 2>/dev/null || :
release=$($bb uname -r)
log "kernel $release checkpoint=${checkpoint_target:-none}"
checkpoint init
start_flash_logger

# Kleaf ramdisks use lib/modules/<release>/; older Pixel ramdisks are flat.
# Android's first-stage init accepts both, and so does this one.
first_stage=/lib/modules/$release
[ -f "$first_stage/modules.load" ] || first_stage=/lib/modules
modules_skip=$($bb sed -n 's/.*ferrix\.modules_skip=\([A-Za-z0-9_,-]*\).*/\1/p' /proc/cmdline | $bb tr - _)
# The modprobe shim refuses these too, so a dependency cannot pull them back in.
export FERRIX_MODULES_SKIP="$modules_skip"
modules_limit=$($bb sed -n 's/.*ferrix\.modules_limit=\([0-9]*\).*/\1/p' /proc/cmdline)
load_list "$first_stage/modules.load" "$first_stage" "$modules_limit"
$bb mdev -s 2>/dev/null || :
# The USB controller needs the clock/power-domain/PHY providers from the list
# above; GKI's deferred-probe timeout gives up on devices whose suppliers come
# late, so bring the console up only after the whole list is in.
start_usb_debug
checkpoint gadget
checkpoint modules

# The Exynos watchdog (s3c2410_wdt) arms during first-stage loading; Android's
# watchdogd normally pets it. Keep it fed so a quiet userspace is observable
# instead of a silent reset. The daemon survives switch_root.
for dog in /dev/watchdog0 /dev/watchdog; do
	[ -c "$dog" ] && {
		$bb watchdog -t 10 -T 30 "$dog" && log "feeding $dog"
		break
	}
done

$bb mkdir -p /newroot
root_device=
attempt=0
while [ "$attempt" -lt 60 ]; do
	$bb mdev -s 2>/dev/null || :
	root_device=$(find_root_device) && break
	attempt=$((attempt + 1))
	$bb sleep 1
done
[ -n "$root_device" ] || hold_then_reboot "PARTLABEL=$root_partlabel not found"

checkpoint root

log "mounting $root_device"
$bb mount -t ext4 -o rw "$root_device" /newroot || hold_then_reboot "cannot mount $root_device"
checkpoint mounted

# Keep the previous boot's pstore with the rootfs for later inspection.
if [ -n "$($bb ls /sys/fs/pstore 2>/dev/null)" ]; then
	saved="/newroot/var/log/ferrix-pstore/$($bb date +%s)"
	$bb mkdir -p "$saved" && $bb cp /sys/fs/pstore/* "$saved/" 2>/dev/null && log "saved pstore to ${saved#/newroot}"
fi

modules="/newroot/lib/modules/$release"
load_list "$modules/system_dlkm.modules.load" "$modules"
load_list "$modules/vendor_dlkm.modules.load" "$modules"
$bb mdev -s 2>/dev/null || :
checkpoint dlkm

[ -e /newroot/sbin/init ] || [ -L /newroot/sbin/init ] || hold_then_reboot '/sbin/init missing from the rootfs'

handoff_usb_console
$bb mount -o move /dev /newroot/dev 2>/dev/null || :
$bb mount -o move /proc /newroot/proc 2>/dev/null || :
$bb mount -o move /sys /newroot/sys 2>/dev/null || :
checkpoint switch
log 'switching to postmarketOS init'
# switch_root must run as PID 1, so exec it. If it fails, PID 1 exits and
# the kernel panics and reboots (CONFIG_PANIC_TIMEOUT=-1), which still ends in
# the bootloader's retry/fallback to the stock slot.
exec $bb switch_root /newroot /sbin/init
