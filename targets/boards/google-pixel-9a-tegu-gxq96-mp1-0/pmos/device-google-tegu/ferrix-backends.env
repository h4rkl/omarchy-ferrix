FERRIX_TARGET=google-pixel-9a-tegu-gxq96-mp1-0
FERRIX_EVIDENCE=physical:google-pixel-9a-tegu-gxq96-mp1-0
FERRIX_NETWORK_BACKEND=networkmanager
FERRIX_TELEPHONY_BACKEND=modemmanager
# Carrier-specific packet data may require an explicit APN for the pinned
# Samsung-SIT plugin. Leave empty until the operator supplies the carrier APN;
# it is non-secret and is passed only to the Settings client at runtime.
FERRIX_TELEPHONY_APN=
# The package pairs the external S5300 loader/SIT proxy with the pinned
# radio-first s5300_modem WWAN kernel backend.  The Kleaf dev composer rewrites
# only this line to the Google Kleaf CPIF backend, which the init scripts map
# to its own explicit CLI and nodes.  Either way no S5300 service is in a
# runlevel; see s5300-cpif-integration.md.
FERRIX_S5300_KERNEL_BACKEND=linux-google-tegu-wwan
FERRIX_BLUETOOTH_BACKEND=bluez
FERRIX_AUDIO_BACKEND=wireplumber
FERRIX_POWER_BACKEND=upower
