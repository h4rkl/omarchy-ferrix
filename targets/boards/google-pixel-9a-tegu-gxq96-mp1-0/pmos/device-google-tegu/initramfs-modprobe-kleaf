#!/bin/busybox sh

# /system/bin/modprobe for the Kleaf GKI development route (CONFIG_MODPROBE_PATH).
# Before /init runs, GKI's finalize_pkvm() loads each module named in
# kvm-arm.protected_modules= (tegu: exynos-pd, pkvm_s2mpu-v9) through a
# usermode helper invoked as:
#   modprobe -q [-d /lib/modules/] -- NAME
# Only /proc is mounted at that point. Resolve NAME (dashes and underscores
# are equivalent) in the vendor_kernel_boot modules.dep and insert its
# dependencies first, then the module itself.

bb=/bin/busybox
directory=/lib/modules
while [ "$#" -gt 0 ]; do
	case "$1" in
		-q) ;;
		-d) shift; directory=${1%/} ;;
		--) shift; break ;;
		*) break ;;
	esac
	shift
done
name=$(printf '%s' "$1" | $bb tr - _)
[ -n "$name" ] || exit 1

# The bootloader appends module parameters (e.g. ufs_pixel_fips140.fips_first_lba=,
# exynos_drm.panel_name=) to the kernel command line. The kernel applies those
# only to built-in drivers; like Android's first-stage init, pass them to
# insmod for loadable modules. Values containing spaces are not supported.
module_args() {
	name=$(printf '%s' "${1##*/}" | $bb sed 's/\.ko$//' | $bb tr - _)
	$bb tr ' ' '\n' </proc/cmdline | $bb sed -n "s/^$name\.\([A-Za-z0-9_]*=[^\"]*\)$/\1/p" | $bb tr '\n' ' '
}

release=$($bb uname -r)
base=
for candidate in "$directory/$release" "$directory" "/lib/modules/$release"; do
	[ -f "$candidate/modules.dep" ] && {
		base=$candidate
		break
	}
done
[ -n "$base" ] || exit 1

line=$($bb awk -v want="$name" '{
	path = $1
	sub(/:$/, "", path)
	file = path
	sub(/^.*\//, "", file)
	sub(/\.ko$/, "", file)
	gsub(/-/, "_", file)
	if (file == want) { print; exit }
}' "$base/modules.dep")
[ -n "$line" ] || exit 1

module=${line%%:*}
dependencies=${line#*:}
# modules.dep lists the deepest dependency last; insert in reverse order.
reversed=
for dependency in $dependencies; do
	reversed="$dependency $reversed"
done
# Kleaf writes paths relative to the release directory; older Pixel ramdisks
# write absolute /lib/modules/NAME.ko paths.
resolve() {
	case "$1" in
		/*) printf '%s\n' "$1" ;;
		*) printf '%s\n' "$base/$1" ;;
	esac
}
for dependency in $reversed; do
	# shellcheck disable=SC2046
	$bb insmod "$(resolve "$dependency")" $(module_args "$dependency") 2>/dev/null || :
done
# shellcheck disable=SC2046
$bb insmod "$(resolve "$module")" $(module_args "$module") 2>/dev/null && exit 0
# Already loaded counts as success.
$bb grep -q "^$name " /proc/modules
