#!/sbin/openrc-run
# OPT-IN Android compatibility runtime (Waydroid, ADR-005/ADR-008) for the
# Pixel 9a development route. Installed by the package but linked into the
# default runlevel only by tools/pixel-9a/dev-compose.py --android, which
# also stages the Waydroid images and /usr/lib/ferrix/ferrix-waydroid.sh
# (shared with the QEMU route). The Browser is LineageOS Jelly, built into
# the Android image.
#
# The bootstrap runs in the background so the product shell is never delayed:
# offline `waydroid init` and container start, then (once ferrix-shell's
# Wayland socket exists) the session as `user`, Android setup, and the
# default browser role. Records go to /var/log/ferrix-android.log with the
# physical evidence label; none of them claims a rendered frame.

[ -r /etc/ferrix/backends.env ] && . /etc/ferrix/backends.env

name="Ferrix Android runtime"
description="Initializes Waydroid and provisions the Browser for user"

helper=/usr/lib/ferrix/ferrix-waydroid.sh
pidfile=/run/ferrix-android.pid
logfile=/var/log/ferrix-android.log

export FERRIX_ANDROID_EVIDENCE="${FERRIX_EVIDENCE:-physical:google-pixel-9a-tegu-gxq96-mp1-0}"
export FERRIX_ANDROID_SESSION_USER=user
export FERRIX_ANDROID_XDG_RUNTIME_DIR=/run/user/1000
export FERRIX_ANDROID_WAYLAND_DISPLAY=wayland-0
# ferrix-product.initd hands the same address to ferrix-appd.
export FERRIX_ANDROID_SESSION_BUS=unix:path=/run/user/1000/bus
# Android audio through pipewire-pulse on the PipeWire session ferrix-audio
# runs; ferrix-waydroid.sh falls back to a null-sink socket without it.
export FERRIX_ANDROID_PULSE=pipewire
export FERRIX_ANDROID_CONSOLE="$logfile"
export FERRIX_ANDROID_RUN_DIR=/run/ferrix-android
# Waydroid's Python tooling must not write bytecode into the rootfs at runtime.
export PYTHONDONTWRITEBYTECODE=1

depend() {
	need dbus
	use cgroups ferrix-audio
	after udev networkmanager ferrix-audio
	before ferrix-product
}

start_pre() {
	[ -f "$helper" ] || {
		eerror "Android runtime helper is missing: $helper"
		return 1
	}
	command -v waydroid >/dev/null 2>&1 || {
		eerror "waydroid is not installed (base rootfs built without FERRIX_PIXEL9A_ANDROID=1)"
		return 1
	}
	. /usr/lib/ferrix/openrc.sh
	ferrix_user_runtime_dir || return 1
	checkpath -d -m 0755 "$FERRIX_ANDROID_RUN_DIR"
	checkpath -f -m 0644 "$logfile"
}

start() {
	ebegin "Starting Ferrix Android runtime bootstrap"
	# A one-shot bootstrap, not a daemon: started detached so OpenRC does not
	# report the service crashed once provisioning finishes. The pidfile only
	# lets stop() end an attempt that is still running.
	( /bin/sh "$helper" run >>"$logfile" 2>&1 & echo $! >"$pidfile" )
	eend $?
}

stop() {
	ebegin "Stopping Ferrix Android runtime"
	[ -s "$pidfile" ] && kill "$(cat "$pidfile")" 2>/dev/null || true
	rm -f "$pidfile"
	waydroid session stop >/dev/null 2>&1 || true
	rc-service waydroid-container stop >/dev/null 2>&1 || true
	eend 0
}
