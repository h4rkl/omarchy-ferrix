#!/sbin/openrc-run

[ -r /etc/ferrix/backends.env ] && . /etc/ferrix/backends.env
export FERRIX_TARGET FERRIX_EVIDENCE FERRIX_NETWORK_BACKEND FERRIX_TELEPHONY_BACKEND FERRIX_BLUETOOTH_BACKEND FERRIX_AUDIO_BACKEND FERRIX_POWER_BACKEND

# WirePlumber for the PipeWire session (ferrix-pipewire). Both daemons run in
# the foreground and neither accepts --no-daemon; supervise-daemon restarts
# either one if it dies (bounded) instead of leaving the session silent
# until the next boot.
name="Ferrix PipeWire/WirePlumber session"
description="Starts WirePlumber for the native PipeWire user session"

runtime_dir=/run/user/1000
command=/usr/bin/wireplumber
command_user="user:user"
supervisor=supervise-daemon
supervise_daemon_args="--env XDG_RUNTIME_DIR=$runtime_dir"
respawn_delay=2
respawn_max=5
respawn_period=60
pidfile=/run/ferrix-wireplumber.pid

depend() {
	need ferrix-pipewire
	after bluetooth
}

start_pre() {
	for binary in wireplumber wpctl; do
		command -v "$binary" >/dev/null 2>&1 || {
			eerror "$binary is not installed"
			return 1
		}
	done
}

start_post() {
	# OpenRC can start ferrix-core immediately after this script returns.  Wait
	# until the user PipeWire session answers a harmless status query so the
	# target adapter does not lose its first connection to WirePlumber.
	for _ in $(seq 1 100); do
		if su -s /bin/sh user -c "XDG_RUNTIME_DIR=$runtime_dir wpctl status >/dev/null 2>&1"; then
			return 0
		fi
		sleep 0.1
	done
	eerror "WirePlumber did not answer within 10 seconds"
	return 1
}
