+    #[test]
+    fn poll_revents_classification() {
+        assert_eq!(classify_revents(0, 0), Ready::Idle);
+        assert_eq!(classify_revents(1, libc::POLLIN), Ready::Readable);
+        assert_eq!(
+            classify_revents(1, libc::POLLIN | libc::POLLRDNORM),
+            Ready::Readable
+        );
+        assert_eq!(
+            classify_revents(1, libc::POLLIN | libc::POLLHUP),
+            Ready::Readable
+        );
+        assert_eq!(classify_revents(1, libc::POLLHUP), Ready::Hangup);
+        assert_eq!(classify_revents(1, libc::POLLERR), Ready::Hangup);
+        assert_eq!(classify_revents(1, libc::POLLNVAL), Ready::Hangup);
+    }
