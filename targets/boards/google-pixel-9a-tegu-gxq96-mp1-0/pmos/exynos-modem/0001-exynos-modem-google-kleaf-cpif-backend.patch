+    impl PolledChannel for FakeCpif {
+        fn wait_readable(&mut self, timeout_ms: i32) -> io::Result<Ready> {
+            assert!(timeout_ms > 0, "poll must be bounded and blocking");
+            assert!(self.armed.is_none(), "polled again without reading");
+            self.polls += 1;
+            match self.steps.pop_front().expect("serve ran past the script") {
+                Step::Idle => Ok(Ready::Idle),
+                Step::Hangup => Ok(Ready::Hangup),
+                step => {
+                    self.armed = Some(step);
+                    Ok(Ready::Readable)
+                }
+            }
+        }
+    }
+
+    impl Read for FakeCpif {
+        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+            self.reads += 1;
+            match self.armed.take().expect("read() without POLLIN") {
+                Step::Empty => Ok(0),
+                Step::Interrupted => Err(io::ErrorKind::Interrupted.into()),
+                Step::Frame(f) => {
+                    buf[..f.len()].copy_from_slice(&f);
+                    Ok(f.len())
+                }
+                Step::Idle | Step::Hangup => unreachable!(),
+            }
+        }
+    }
+
+    impl Write for FakeCpif {
+        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+            if self.fail_writes {
+                return Err(io::Error::from_raw_os_error(libc::EAGAIN));
+            }
+            self.written.push(buf.to_vec());
+            Ok(buf.len())
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn cpif_empty_read_is_not_eof() {
+        let oem = Oem::new(PathBuf::from("/nonexistent"), false);
+        let mut ch = FakeCpif::new(vec![
+            Step::Idle,
+            Step::Empty,
+            Step::Idle,
+            Step::Empty,
+            Step::Interrupted,
+            Step::Frame(property_write_request(4)),
+            Step::Empty,
+            Step::Hangup,
+        ]);
+        // One session on one handle: the empty reads neither end it nor
+        // reopen the node, and the request after them is still answered.
+        serve_polled(&mut ch, &oem).unwrap();
+        assert_eq!(ch.polls, 8);
+        assert_eq!(ch.reads, 5); // only after POLLIN, never on Idle/Hangup
+        assert_eq!(ch.written.len(), 1);
+        assert_eq!(
+            ch.written[0],
+            vec![
+                0x08, 0x02, 0x15, 0x07, 0x00, 0x00, 0x00, 0x1d, 0x04, 0x00, 0x00, 0x00, 0x20, 0x00,
+                0x3a, 0x02, 0x22, 0x00,
+            ]
+        );
+    }
