+    #[test]
+    fn cpif_session_ends_only_on_hangup_or_error() {
+        let oem = Oem::new(PathBuf::from("/nonexistent"), false);
+        let mut ch = FakeCpif::new(vec![Step::Hangup]);
+        serve_polled(&mut ch, &oem).unwrap();
+        assert_eq!(ch.reads, 0);
+        // A rejected write (e.g. -EAGAIN before INIT_END) ends the session
+        // with an error so run() reopens; it is not swallowed.
+        let mut ch = FakeCpif::new(vec![Step::Frame(property_write_request(9))]);
+        ch.fail_writes = true;
+        assert!(serve_polled(&mut ch, &oem).is_err());
+    }
