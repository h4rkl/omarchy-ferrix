+    /// Model of CPIF shmem_ioctl(IOCTL_GET_SRINFO) over a user buffer.
+    fn cpif_kernel_get_srinfo(region: &[u8], user: &mut [u8]) {
+        let count = u32::from_ne_bytes([user[0], user[1], user[2], user[3]]) as usize;
+        let size = region.len().min(count);
+        user[..4].copy_from_slice(&(size as u32).to_ne_bytes());
+        user[4..4 + size].copy_from_slice(&region[..size]);
+    }
+
+    #[test]
+    fn cpif_srinfo_is_inline_after_size() {
+        let region: Vec<u8> = (0..100u8).collect();
+        // Capacity smaller than the region: the kernel truncates to it.
+        let mut req = cpif_srinfo_request(40).unwrap();
+        assert_eq!(req.len(), 44);
+        assert_eq!(&req[..4], &40u32.to_ne_bytes());
+        cpif_kernel_get_srinfo(&region, &mut req);
+        let mut out = [0u8; 40];
+        assert_eq!(cpif_srinfo_take(&req, &mut out).unwrap(), 40);
+        assert_eq!(&out[..], &region[..40]);
+        // Capacity larger than the region: only the region comes back.
+        let mut req = cpif_srinfo_request(256).unwrap();
+        cpif_kernel_get_srinfo(&region, &mut req);
+        let mut out = [0u8; 256];
+        assert_eq!(cpif_srinfo_take(&req, &mut out).unwrap(), 100);
+        assert_eq!(&out[..100], &region[..]);
+        // A reported length above the buffer is refused, not trusted.
+        let mut bad = cpif_srinfo_request(8).unwrap();
+        bad[..4].copy_from_slice(&9u32.to_ne_bytes());
+        assert!(cpif_srinfo_take(&bad, &mut [0u8; 8]).is_err());
+        assert!(cpif_srinfo_take(&[0u8; 3], &mut [0u8; 8]).is_err());
+    }
+
