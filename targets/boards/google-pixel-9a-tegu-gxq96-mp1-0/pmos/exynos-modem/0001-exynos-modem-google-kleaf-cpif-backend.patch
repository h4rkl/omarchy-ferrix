diff --git a/crates/exynos-modem/src/boot/s5300.rs b/crates/exynos-modem/src/boot/s5300.rs
index 2086f1e..9e041d9 100644
--- a/crates/exynos-modem/src/boot/s5300.rs
+++ b/crates/exynos-modem/src/boot/s5300.rs
@@ -18,6 +18,7 @@ use std::path::Path;
 use std::time::Duration;
 
