diff --git a/crates/exynos-modem/src/backend.rs b/crates/exynos-modem/src/backend.rs
new file mode 100644
index 0000000..dc9d26b
--- /dev/null
+++ b/crates/exynos-modem/src/backend.rs
@@ -0,0 +1,189 @@
+//! Kernel transport backend (Omarchy Ferrix target-local patch).
+//!
+//! The daemon speaks to one of two kernel drivers that both expose a
+//! /dev/umts_boot0 boot node but differ in ioctl encodings, node names and
+//! read semantics:
+//!
+//!   * `linux-google-tegu-wwan` -- the radio-first `s5300_modem` WWAN driver
+//!     this daemon was written against.  The default; its behaviour is
+//!     unchanged by this patch.
+//!   * `google-kleaf-cpif` -- Google's Kleaf CPIF module
+//!     (kernel/google-modules/radio/samsung/s5300 a8976934).  Selected only by
+//!     an explicit `--kernel-backend google-kleaf-cpif`; it is never inferred.
+//!
+//! On the CPIF backend the node set is fixed by the tegu device tree
+//! (zuma-cp-s5300-sit.dtsi): boot = umts_boot0 (ch 241), RFS = umts_rfs0
+//! (ch 41), GEMS = oem_ipc1 (ch 130, the channel the radio-first driver names
+//! umts_oem1).  Any other path is refused before a node is opened, so a
+//! mistyped or other-backend path fails closed instead of reaching a node
+//! with a different protocol.
+
+use std::path::Path;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum KernelBackend {
+    LinuxGoogleTeguWwan,
+    GoogleKleafCpif,
+}
+
+/// The per-channel device a path is configured for.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Channel {
+    Boot,
+    Rfs,
+    OemGems,
+}
+
+impl Channel {
+    pub fn option(self) -> &'static str {
+        match self {
+            Channel::Boot => "--boot-dev",
+            Channel::Rfs => "--rfs-dev",
+            Channel::OemGems => "--oem-gems-dev",
+        }
+    }
+}
+
+impl KernelBackend {
+    pub const DEFAULT: KernelBackend = KernelBackend::LinuxGoogleTeguWwan;
+
+    /// Backends accepted by --kernel-backend, for help/error text.
+    pub const SUPPORTED: &'static str = "linux-google-tegu-wwan, google-kleaf-cpif";
+
+    /// Exact, case-sensitive match: the value is a configuration contract
+    /// shared with the init scripts, not free text.
+    pub fn parse(s: &str) -> Option<KernelBackend> {
+        match s {
+            "linux-google-tegu-wwan" => Some(KernelBackend::LinuxGoogleTeguWwan),
+            "google-kleaf-cpif" => Some(KernelBackend::GoogleKleafCpif),
+            _ => None,
+        }
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            KernelBackend::LinuxGoogleTeguWwan => "linux-google-tegu-wwan",
+            KernelBackend::GoogleKleafCpif => "google-kleaf-cpif",
+        }
+    }
+
+    pub fn default_dev(self, ch: Channel) -> &'static str {
+        match (self, ch) {
+            (_, Channel::Boot) => "/dev/umts_boot0",
+            (_, Channel::Rfs) => "/dev/umts_rfs0",
+            (KernelBackend::LinuxGoogleTeguWwan, Channel::OemGems) => "/dev/umts_oem1",
+            (KernelBackend::GoogleKleafCpif, Channel::OemGems) => "/dev/oem_ipc1",
+        }
+    }
+
+    /// Refuse a path the backend does not define for this channel.  The WWAN
+    /// backend keeps the upstream free-form paths (e.g. /dev/wwan0rfs0); the
+    /// CPIF backend accepts only its device-tree node.
+    pub fn check_dev(self, ch: Channel, path: &Path) -> Result<(), String> {
+        match self {
+            KernelBackend::LinuxGoogleTeguWwan => Ok(()),
+            KernelBackend::GoogleKleafCpif => {
+                // Byte-exact: Path equality would ignore a trailing '/'.
+                let want = self.default_dev(ch);
+                if path.as_os_str() == want {
+                    Ok(())
+                } else {
+                    Err(format!(
+                        "{} {} is not the {} node (expected {} or none)",
+                        ch.option(),
+                        path.display(),
+                        self.name(),
+                        want
+                    ))
+                }
+            }
+        }
+    }
+
+    /// Whether the crash-reason dump-boot (reset(dump) + PBL + START(dump) +
+    /// GET_SRINFO) may run.  On CPIF, START_CP_BOOTLOADER(DUMP) enters the
+    /// kernel's start_dump_boot path, whose link/PCIe effects have not been
+    /// reviewed against CP3A; the dump-boot is disabled there and the kernel
+    /// log is the only crash-cause source (a documented diagnostic limit).
+    pub fn crash_dump_boot(self) -> bool {
+        match self {
+            KernelBackend::LinuxGoogleTeguWwan => true,
+            KernelBackend::GoogleKleafCpif => false,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_only_exact_backend_names() {
+        assert_eq!(
+            KernelBackend::parse("linux-google-tegu-wwan"),
+            Some(KernelBackend::LinuxGoogleTeguWwan)
+        );
+        assert_eq!(
+            KernelBackend::parse("google-kleaf-cpif"),
+            Some(KernelBackend::GoogleKleafCpif)
+        );
+        for bad in [
+            "",
+            "cpif",
+            "Google-Kleaf-CPIF",
+            "google-kleaf-cpif ",
+            "wwan",
+        ] {
+            assert_eq!(KernelBackend::parse(bad), None, "{bad:?}");
+        }
+        assert_eq!(KernelBackend::DEFAULT, KernelBackend::LinuxGoogleTeguWwan);
+    }
+
+    #[test]
+    fn default_nodes_per_backend() {
+        let w = KernelBackend::LinuxGoogleTeguWwan;
+        let c = KernelBackend::GoogleKleafCpif;
+        assert_eq!(w.default_dev(Channel::Boot), "/dev/umts_boot0");
+        assert_eq!(w.default_dev(Channel::Rfs), "/dev/umts_rfs0");
+        assert_eq!(w.default_dev(Channel::OemGems), "/dev/umts_oem1");
+        assert_eq!(c.default_dev(Channel::Boot), "/dev/umts_boot0");
+        assert_eq!(c.default_dev(Channel::Rfs), "/dev/umts_rfs0");
+        assert_eq!(c.default_dev(Channel::OemGems), "/dev/oem_ipc1");
+    }
+
+    #[test]
+    fn cpif_refuses_other_backend_and_unknown_nodes() {
+        let c = KernelBackend::GoogleKleafCpif;
+        for (ch, bad) in [
+            (Channel::OemGems, "/dev/umts_oem1"),
+            (Channel::OemGems, "/dev/oem_ipc0"),
+            (Channel::OemGems, "/dev/oem_ipc1/"),
+            (Channel::Rfs, "/dev/wwan0rfs0"),
+            (Channel::Rfs, "/dev/umts_ipc0"),
+            (Channel::Boot, "/dev/umts_boot1"),
+            (Channel::Boot, "umts_boot0"),
+        ] {
+            assert!(c.check_dev(ch, Path::new(bad)).is_err(), "{bad}");
+        }
+        for ch in [Channel::Boot, Channel::Rfs, Channel::OemGems] {
+            assert!(c.check_dev(ch, Path::new(c.default_dev(ch))).is_ok());
+        }
+    }
+
+    #[test]
+    fn wwan_keeps_upstream_free_form_paths() {
+        let w = KernelBackend::LinuxGoogleTeguWwan;
+        assert!(w
+            .check_dev(Channel::Rfs, Path::new("/dev/wwan0rfs0"))
+            .is_ok());
+        assert!(w
+            .check_dev(Channel::OemGems, Path::new("/dev/umts_oem1"))
+            .is_ok());
+    }
+
+    #[test]
+    fn dump_boot_only_on_wwan() {
+        assert!(KernelBackend::LinuxGoogleTeguWwan.crash_dump_boot());
+        assert!(!KernelBackend::GoogleKleafCpif.crash_dump_boot());
+    }
+}
