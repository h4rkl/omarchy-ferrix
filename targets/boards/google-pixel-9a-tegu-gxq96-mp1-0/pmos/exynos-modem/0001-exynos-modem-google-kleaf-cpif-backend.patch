+    #[test]
+    fn cpif_ioctl_encodings_match_modem_prj_h() {
+        assert_eq!(CPIF_IOCTL_POWER_RESET, 0x4004_6f21);
+        assert_eq!(CPIF_IOCTL_GET_SRINFO, 0x0000_6f45);
