+// Google Kleaf CPIF (radio/samsung/s5300 a8976934, modem_prj.h) -- only the two
+// commands whose encoding or argument differs from the WWAN driver above; every
+// other boot ioctl is numerically identical on both (s5300-cpif-e0.md).
+// IOCTL_POWER_RESET takes a pointer to struct boot_mode { enum cp_boot_mode },
+// handled in bootdump_ioctl (bootdump_io_device.c).
+const CPIF_IOCTL_POWER_RESET: u32 = iow(MAGIC, 0x21, 4); // sizeof(struct boot_mode)
+                                                         // IOCTL_GET_SRINFO is _IO and takes struct shmem_srinfo { u32 size; char buf[]; }
+                                                         // with the record copied inline after `size` (shmem_ioctl, link_device.c).
+const CPIF_IOCTL_GET_SRINFO: u32 = io(MAGIC, 0x45);
+// enum cp_boot_mode indices accepted by IOCTL_POWER_RESET.
+const CPIF_BOOT_MODE_NORMAL: u32 = 0; // mc->ops.power_reset: full power off/on
+const CPIF_BOOT_MODE_DUMP: u32 = 1; // power_reset_dump(mc, 0): wreset, DUMP_NOTI high
+const CPIF_BOOT_MODE_SILENT: u32 = 3; // power_reset_dump(mc, 1): wreset, DUMP_NOTI low
+
+/// struct boot_mode: a single C enum (int-sized).
+#[repr(C)]
+struct CpifBootMode {
+    idx: u32,
+}
+
 pub(crate) const MSS: usize = 0xc000; // std_dl payload/frame (cbd's 0xC000, hw-confirmed)
 const ACK_WAIT_MS: i32 = 16000; // total wait for a std_dl ack
 pub(crate) const TOC_BYTES: usize = 0x400; // 32 records x 32 bytes
@@ -145,11 +167,51 @@ pub(crate) enum ResetMode {
     Cold = 2,
 }
 
-/// CP reset primitive (kernel IOCTL_CP_RESET, cbd's POWER_RESET).
-pub(crate) fn cp_reset(fd: RawFd, mode: ResetMode) -> io::Result<()> {
-    let r = ioctl_int(fd, IOCTL_CP_RESET, mode as libc::c_ulong);
+/// How the reset mode travels in the ioctl argument slot.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum ResetArg {
+    /// WWAN `_IO`: the mode itself is the integer argument.
+    Int(libc::c_ulong),
+    /// CPIF `_IOW`: a pointer to struct boot_mode carrying this index.
+    BootModePtr(u32),
+}
+
+/// The (request, argument) a reset sends on `backend`.  CPIF has no "warm"
+/// or "cold" names; map by kernel action: Cold -> NORMAL (full power off/on),
+/// Dump -> DUMP (wreset, DUMP_NOTI high), Warm -> SILENT (wreset, DUMP_NOTI
+/// low).
+pub(crate) fn reset_request(backend: KernelBackend, mode: ResetMode) -> (u32, ResetArg) {
+    match backend {
+        KernelBackend::LinuxGoogleTeguWwan => {
+            (IOCTL_CP_RESET, ResetArg::Int(mode as libc::c_ulong))
+        }
+        KernelBackend::GoogleKleafCpif => {
+            let idx = match mode {
+                ResetMode::Cold => CPIF_BOOT_MODE_NORMAL,
+                ResetMode::Dump => CPIF_BOOT_MODE_DUMP,
+                ResetMode::Warm => CPIF_BOOT_MODE_SILENT,
+            };
+            (CPIF_IOCTL_POWER_RESET, ResetArg::BootModePtr(idx))
+        }
+    }
+}
+
+/// CP reset primitive (kernel IOCTL_CP_RESET / IOCTL_POWER_RESET, cbd's
+/// POWER_RESET).
+pub(crate) fn cp_reset(fd: RawFd, backend: KernelBackend, mode: ResetMode) -> io::Result<()> {
+    let (req, arg) = reset_request(backend, mode);
+    let r = match arg {
+        ResetArg::Int(v) => ioctl_int(fd, req, v),
+        ResetArg::BootModePtr(idx) => {
+            let mut bm = CpifBootMode { idx };
+            ioctl_ptr(fd, req, &mut bm as *mut CpifBootMode as *mut libc::c_void)
+        }
+    };
     if r < 0 {
-        return Err(err(format!("IOCTL_CP_RESET({:?}) FAILED ret {}", mode, r)));
+        return Err(err(format!(
+            "CP reset {:?} ({:#x}) FAILED ret {}",
+            mode, req, r
+        )));
     }
     Ok(())
 }
