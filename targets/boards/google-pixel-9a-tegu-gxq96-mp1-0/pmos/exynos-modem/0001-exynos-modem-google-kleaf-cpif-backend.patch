@@ -177,6 +251,30 @@ pub(crate) fn get_srinfo(fd: RawFd, out: &mut [u8]) -> io::Result<usize> {
     Ok(req.len as usize)
 }
 
+/// CPIF struct shmem_srinfo for a `cap`-byte read: the u32 capacity, then
+/// `cap` bytes the kernel fills inline.
+fn cpif_srinfo_request(cap: usize) -> io::Result<Vec<u8>> {
+    let size = u32::try_from(cap).map_err(|_| err("srinfo buffer too large"))?;
+    let mut req = vec![0u8; 4 + cap];
+    req[..4].copy_from_slice(&size.to_ne_bytes());
+    Ok(req)
+}
+
+/// Read back the length the kernel wrote (min(region, cap)) and copy that
+/// many inline bytes into `out`; a length above the capacity is refused.
+fn cpif_srinfo_take(req: &[u8], out: &mut [u8]) -> io::Result<usize> {
+    if req.len() < 4 {
+        return Err(err("srinfo reply shorter than its header"));
+    }
+    let n = u32::from_ne_bytes([req[0], req[1], req[2], req[3]]) as usize;
+    let cap = (req.len() - 4).min(out.len());
+    if n > cap {
+        return Err(err(format!("srinfo length {} exceeds buffer {}", n, cap)));
+    }
+    out[..n].copy_from_slice(&req[4..4 + n]);
+    Ok(n)
+}
