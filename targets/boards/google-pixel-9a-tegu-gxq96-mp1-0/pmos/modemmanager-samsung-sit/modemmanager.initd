#!/sbin/openrc-run

supervisor=supervise-daemon
command=/usr/sbin/ModemManager
# postmarketOS's conf.d passes --test-quick-suspend-resume, which only exists
# when ModemManager is built with suspend/resume support; this build is not
# (-Dsystemd_suspend_resume=false) and exits on the unknown option.
command_args="$(printf '%s' "${modemmanager_opts}" | sed 's/--test-quick-suspend-resume//')"
description="ModemManager Samsung SIT daemon"

depend() {
	need dbus
	need ferrix-s5300-mounts exynos-modem sit-proxy
	after udev ferrix-s5300-mounts exynos-modem sit-proxy
}
