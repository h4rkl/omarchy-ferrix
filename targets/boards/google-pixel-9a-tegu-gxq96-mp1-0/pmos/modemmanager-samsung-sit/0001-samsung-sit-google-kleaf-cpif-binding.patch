diff -ruN a/src/mm-plugin.c b/src/mm-plugin.c
--- a/src/mm-plugin.c	2026-11-25 10:49:56
+++ b/src/mm-plugin.c	2026-11-25 10:49:57
@@ -24,6 +24,7 @@
 #include <string.h>
 
 #include <ModemManager.h>
+#include <ModemManager-tags.h>
 #include <mm-errors-types.h>
 
 #include "mm-plugin.h"
@@ -271,6 +272,15 @@
         return TRUE;
     }
 
+    /* A Google CPIF character device is one of many unrelated CP channels
+     * (boot, RFS, OEM, logging). Only a port that udev explicitly declared
+     * as SIT is ever considered, so no other channel is opened or probed. */
+    if (g_str_equal (mm_kernel_device_get_subsystem (port), "cpif") &&
+        !mm_kernel_device_get_property_as_boolean (port, ID_MM_PORT_TYPE_SIT)) {
+        mm_obj_dbg (self, "port %s filtered: cpif port not declared as SIT", mm_kernel_device_get_name (port));
+        return TRUE;
+    }
+
     /* The plugin may specify that only some drivers are supported, or that some
      * drivers are not supported. If that is the case, filter by driver.
      *
@@ -753,6 +763,10 @@
     { "usbmisc", MM_PORT_PROBE_QMI | MM_PORT_PROBE_MBIM | MM_PORT_PROBE_AT },
     { "rpmsg",   MM_PORT_PROBE_AT | MM_PORT_PROBE_QMI },
     { "wwan",    MM_PORT_PROBE_QMI | MM_PORT_PROBE_MBIM | MM_PORT_PROBE_AT | MM_PORT_PROBE_QCDM },
+    /* Google CPIF: only udev-declared SIT ports get this far (see
+     * apply_pre_probing_filters()), and a SIT port's probe results are all
+     * preset, so this never sends anything to the device. */
+    { "cpif",    MM_PORT_PROBE_AT },
 #if defined WITH_QRTR
     { "qrtr",    MM_PORT_PROBE_QMI },
 #endif
