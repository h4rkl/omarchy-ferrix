diff -ruN a/src/plugins/samsung-sit/tests/test-sit-protocol.c b/src/plugins/samsung-sit/tests/test-sit-protocol.c
--- a/src/plugins/samsung-sit/tests/test-sit-protocol.c	2026-11-25 10:49:56
+++ b/src/plugins/samsung-sit/tests/test-sit-protocol.c	2026-11-25 10:49:57
@@ -1696,6 +1696,44 @@
     g_assert_true (ctx.completed);
 }
 
+static void
+test_client_proxy_socket_path (void)
+{
+    static const struct {
+        const gchar *device;
+        const gchar *socket;
+    } cases[] = {
+        { "wwan0sit0",          "/run/sit-proxy/0" },
+        { "/dev/wwan0sit1",     "/run/sit-proxy/1" },
+        /* Google Kleaf CPIF FMT channels 245/246, in sit-proxy's --dev order. */
+        { "umts_ipc0",          "/run/sit-proxy/0" },
+        { "/dev/umts_ipc1",     "/run/sit-proxy/1" },
+        { "something-else",     "/run/sit-proxy/0" },
+    };
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (cases); i++) {
+        g_autofree gchar *path = mm_sit_proxy_socket_path (cases[i].device);
+
+        g_assert_cmpstr (path, ==, cases[i].socket);
+    }
+}
+
+static void
+test_client_proxy_only_no_fallback (void)
+{
+    g_autoptr(MMSitClient) client = NULL;
+
+    /* A proxy-only client talks to sit-proxy's socket from the start and keeps
+     * the CPIF node name as its identity. (Its open() failure path logs at
+     * warning level, which this test binary has no log backend for, so the
+     * missing fallback is covered by source review rather than here.) */
+    client = mm_sit_client_new_proxy_only ("/dev/umts_ipc1");
+    g_assert_true (mm_sit_client_is_proxied (client));
+    g_assert_cmpstr (mm_sit_client_get_device (client), ==, "umts_ipc1");
+    g_assert_false (mm_sit_client_is_open (client));
+}
+
 int
 main (int argc,
       char **argv)
@@ -1727,6 +1765,8 @@
     g_test_add_func ("/MM/sit/client/connect-sequence", test_client_connect_sequence);
     g_test_add_func ("/MM/sit/client/radio-transition", test_client_radio_transition);
     g_test_add_func ("/MM/sit/client/boot-config", test_client_boot_config);
+    g_test_add_func ("/MM/sit/client/proxy-socket-path", test_client_proxy_socket_path);
+    g_test_add_func ("/MM/sit/client/proxy-only-no-fallback", test_client_proxy_only_no_fallback);
 
     return g_test_run ();
 }
