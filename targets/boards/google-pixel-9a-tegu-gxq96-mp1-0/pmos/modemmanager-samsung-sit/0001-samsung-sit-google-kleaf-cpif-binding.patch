diff -ruN a/src/plugins/samsung-sit/mm-sit-client.c b/src/plugins/samsung-sit/mm-sit-client.c
--- a/src/plugins/samsung-sit/mm-sit-client.c	2026-11-25 10:49:56
+++ b/src/plugins/samsung-sit/mm-sit-client.c	2026-11-25 10:49:57
@@ -108,9 +108,17 @@
             index = p;
     }
     if (!index) {
-        /* An unrecognised name (a downstream-style /dev/umts_ipc0, say) has no
-         * index to read; assume the first stack, which is the one that carries
-         * everything today. */
+        /* Google's CPIF names the same two FMT channels umts_ipc0/umts_ipc1,
+         * and sit-proxy is given them in that order, so the trailing index
+         * selects the socket exactly as it does for wwan0sitN. */
+        const gchar *ipc = g_strrstr (device, "umts_ipc");
+
+        if (ipc && g_ascii_isdigit (ipc[strlen ("umts_ipc")]))
+            index = ipc + strlen ("umts_ipc");
+    }
+    if (!index) {
+        /* Any other unrecognised name has no index to read; assume the first
+         * stack, which is the one that carries everything today. */
         index = "0";
     }
     return g_build_filename (MM_SIT_PROXY_SOCKET_DIRECTORY, index, NULL);
@@ -135,6 +143,18 @@
     self->priv->device = g_strdup (name);
     self->priv->proxy_fallback_device = g_strdup (name);
     self->priv->port = mm_port_serial_sit_new_socket (socket_path);
+    return self;
+}
+
+MMSitClient *
+mm_sit_client_new_proxy_only (const gchar *device)
+{
+    MMSitClient *self;
+
+    self = mm_sit_client_new_proxy (device);
+    /* Without a fallback device, mm_sit_client_open() propagates the socket
+     * error instead of opening the node. */
+    g_clear_pointer (&self->priv->proxy_fallback_device, g_free);
     return self;
 }
 
