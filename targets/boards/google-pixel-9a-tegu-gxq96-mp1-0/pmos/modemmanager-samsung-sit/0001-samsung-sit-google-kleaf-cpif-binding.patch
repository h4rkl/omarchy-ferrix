         if (!mm_sit_client_open (client, error)) {
@@ -3627,6 +3632,17 @@
      * well after construction. */
     self->priv->use_proxy = use_proxy;
     return self;
+}
+
+void
+mm_broadband_modem_samsung_sit_set_proxy_required (MMBroadbandModemSamsungSit *self,
