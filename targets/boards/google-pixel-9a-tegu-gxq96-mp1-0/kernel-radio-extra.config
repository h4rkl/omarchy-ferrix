# Native radio-first Kbuild additions for the exact tegu target.
#
# The candidate's arm64 defconfig leaves device-mapper modular. Ferrix boots
# the raw ext4 userdata image directly and does not ship Android's module
# partition, so keep the small block layer dependency built in. The selected
# Wi-Fi, Bluetooth, S5300 WWAN, UFS, ext4, and F2FS paths are already built in
# by tegu.config plus arm64 defconfig.
CONFIG_BLK_DEV_DM=y

# The phone product never hosts virtual machines. Keep the nVHE KVM build out
# of this target route: Zig's arm64 objects otherwise emit
# R_AARCH64_ADR_GOT_PAGE/R_AARCH64_LD64_GOT_LO12_NC (311/312), which the
# kernel's gen-hyprel tool intentionally rejects. This is a target-local
# product decision, not a change to the pinned kernel source.
# CONFIG_KVM is not set
