# Ferrix additions to Google's GKI defconfig for the tegu Kleaf route, applied
# with --defconfig_fragment while building GKI from source
# (--use_prebuilt_gki=false; Kleaf rebuilds the vendor modules against it).
#
# ferrix-sandbox requires user and PID namespaces for app isolation
# (docs/app-platform.md); the prebuilt GKI ships without them.
CONFIG_USER_NS=y
CONFIG_PID_NS=y
# postmarketOS userspace (eudev, OpenRC devfs) expects a devtmpfs /dev.
CONFIG_DEVTMPFS=y
# Waydroid's container network (waydroid-net.sh) adds a mangle CHECKSUM rule
# for DHCP replies and aborts when the target is missing.
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
# IPC namespaces exist only with SysV IPC or POSIX message queues, and GKI has
# neither. Waydroid's LXC container clones CLONE_NEWIPC and fails without it;
# ferrix-sandbox then also gets a real IPC namespace. POSIX mqueue is the
# smaller of the two (bionic has no SysV IPC).
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
