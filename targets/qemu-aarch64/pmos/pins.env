# Pinned inputs for the postmarketOS/pmbootstrap guest route (QEMU evidence only).
# Sourced by the host build script (passed to `docker build` as build args)
# and by the in-container build script. Update all related values together
# and re-run `just pmos-build`; the manifest records what was actually used.

# Builder base image (Alpine 3.20.10 arm64), pinned by digest. Shared with qemu-build.sh.
GUEST_BUILDER_BASE=alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

# pmbootstrap: not published on PyPI past 2.1.0 (2023), so the git tag is pinned
# and its resolved commit is verified at image build time.
PMBOOTSTRAP_REPO=https://gitlab.postmarketos.org/postmarketOS/pmbootstrap.git
PMBOOTSTRAP_TAG=3.11.1
PMBOOTSTRAP_COMMIT=130b89d3c391596a1de9c12997b228b1e8a1f692

# pmaports: latest release channel at pin time (channels.cfg on pmaports main).
# v26.06 tracks Alpine 3.24-stable (mirrordir_alpine=v3.24).
PMAPORTS_REPO=https://gitlab.postmarketos.org/postmarketOS/pmaports.git
PMAPORTS_CHANNEL=v26.06
PMAPORTS_BRANCH=v26.06
PMAPORTS_COMMIT=368093c7a882637ee00d32932fb0dafd24cfc4d4
