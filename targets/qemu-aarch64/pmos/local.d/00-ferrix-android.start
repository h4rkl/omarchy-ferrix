#!/bin/sh
# OPT-IN Android compatibility runtime (Waydroid) first-boot setup for the
# postmarketOS QEMU guest. Installed only when the image was built with
# FERRIX_PMOS_ANDROID=1; runs before 00-ferrix-product.start (lexical order)
# so the container service is up before ferrix-appd composes the Android
# runtime. The Waydroid *session* is never started here: ferrix-appd's
# Android adapter starts it on demand as the session user.
# Evidence label QEMU; claim level none until a rendered frame is inspected.
props=${FERRIX_ANDROID_PROPS:-/etc/ferrix/waydroid-properties.ini}
images=${FERRIX_ANDROID_IMAGES:-/etc/waydroid-extra/images}
cfg=${FERRIX_ANDROID_CONFIG:-/var/lib/waydroid/waydroid.cfg}
brave_apk=${FERRIX_ANDROID_BRAVE_APK:-/usr/share/ferrix/android/brave.apk}
brave_package=com.brave.browser
console=${FERRIX_ANDROID_CONSOLE:-/dev/console}
run_dir=${FERRIX_ANDROID_RUN_DIR:-/run/ferrix}
rec() { printf '%s\n' "$1" >> "$console"; logger -t ferrix "$1" 2>/dev/null || true; }
dev_state() { if [ -e "$1" ]; then ls -l "$1" 2>/dev/null | awk '{print $1" "$5" "$6}' | tr ',' ' '; else printf 'absent'; fi; }
mkdir -p "$run_dir"
rec "{\"evidence\":\"QEMU\",\"event\":\"android-binder-devices\",\"binder\":\"$(dev_state /dev/binder)\",\"hwbinder\":\"$(dev_state /dev/hwbinder)\",\"vndbinder\":\"$(dev_state /dev/vndbinder)\",\"psi\":\"$( [ -r /proc/pressure/cpu ] && echo present || echo absent)\"}"
if ! command -v waydroid >/dev/null 2>&1; then
  rec '{"evidence":"QEMU","event":"waydroid-init","status":"failed","reason":"waydroid-not-installed"}'
  exit 0
fi
rc-service dbus start >/dev/null 2>&1 || true
rc-service cgroups start >/dev/null 2>&1 || true
if [ -f "$cfg" ] && grep -q '^images_path' "$cfg"; then
  rec '{"evidence":"QEMU","event":"waydroid-init","status":"already-initialized"}'
else
  if [ -f "$images/system.img" ] && [ -f "$images/vendor.img" ]; then
    if timeout 300 waydroid init -f -i "$images" >"$run_dir/waydroid-init.log" 2>&1; then
      rec '{"evidence":"QEMU","event":"waydroid-init","status":"ok","images":"/etc/waydroid-extra/images","source":"offline"}'
    else
      rec "{\"evidence\":\"QEMU\",\"event\":\"waydroid-init\",\"status\":\"failed\",\"reason\":\"waydroid-init-exit-$?\",\"log\":\"$run_dir/waydroid-init.log\"}"
      tail -n 20 "$run_dir/waydroid-init.log" > "$console" 2>/dev/null || true
    fi
  else
    rec '{"evidence":"QEMU","event":"waydroid-init","status":"failed","reason":"images-missing"}'
  fi
fi
# Software-rendering properties (docs/android-runtime.md section 6.3), added
# once; waydroid init rewrites the file without them.
if [ -f "$cfg" ] && [ -f "$props" ] && ! grep -q '^ro.hardware.egl' "$cfg"; then
  { grep -q '^\[properties\]' "$cfg" || printf '\n[properties]\n'; grep -v '^\[' "$props"; } >> "$cfg"
  rec '{"evidence":"QEMU","event":"waydroid-properties","status":"applied","path":"/var/lib/waydroid/waydroid.cfg"}'
fi
if [ -f "$cfg" ] && rc-service waydroid-container start >"$run_dir/waydroid-container.log" 2>&1; then
  rec '{"evidence":"QEMU","event":"waydroid-container","status":"started"}'
else
  rec "{\"evidence\":\"QEMU\",\"event\":\"waydroid-container\",\"status\":\"failed\",\"log\":\"$run_dir/waydroid-container.log\"}"
fi
# APK installation is bootstrap-owned.  It happens only after the initialized
# container is available, and never in ferrix-appd's launch path: appd merely
# launches an already-installed package.  `waydroid app install` is idempotent
# for this pinned package in the Android package manager, but avoid rewriting
# its data on each guest boot by checking the authoritative package list first.
if [ -f "$brave_apk" ]; then
  rec "{\"evidence\":\"QEMU\",\"event\":\"android-app-staged\",\"app\":\"org.ferrix.browser\",\"path\":\"$brave_apk\"}"
  if ! waydroid app list >"$run_dir/waydroid-app-list.log" 2>&1; then
    rec "{\"evidence\":\"QEMU\",\"event\":\"android-app-install\",\"app\":\"org.ferrix.browser\",\"status\":\"failed\",\"reason\":\"package-list-failed\",\"log\":\"$run_dir/waydroid-app-list.log\"}"
  elif grep -q "^packageName: $brave_package$" "$run_dir/waydroid-app-list.log"; then
    rec '{"evidence":"QEMU","event":"android-app-install","app":"org.ferrix.browser","status":"present","package":"com.brave.browser"}'
  elif waydroid app install "$brave_apk" >"$run_dir/waydroid-brave-install.log" 2>&1 \
    && waydroid app list >"$run_dir/waydroid-app-list.log" 2>&1 \
    && grep -q "^packageName: $brave_package$" "$run_dir/waydroid-app-list.log"; then
    rec '{"evidence":"QEMU","event":"android-app-install","app":"org.ferrix.browser","status":"installed","package":"com.brave.browser"}'
  else
    rec "{\"evidence\":\"QEMU\",\"event\":\"android-app-install\",\"app\":\"org.ferrix.browser\",\"status\":\"failed\",\"reason\":\"install-or-verify-failed\",\"log\":\"$run_dir/waydroid-brave-install.log\"}"
  fi
fi
exit 0
