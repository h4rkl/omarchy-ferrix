#!/bin/sh
# OPT-IN Android compatibility runtime (Waydroid) first-boot setup for the
# postmarketOS QEMU guest. Installed only when the image was built with
# FERRIX_PMOS_ANDROID=1; runs before 00-ferrix-product.start (lexical order)
# so the container service is up before ferrix-appd composes the Android
# runtime. The Waydroid *session* is started by the post-compositor product
# bootstrap, where the Wayland socket exists; ferrix-appd only launches apps.
# The implementation is shared with the Pixel 9a dev route:
# tools/android/guest/ferrix-waydroid.sh, installed by finalize-in-container.sh.
# Evidence label QEMU; claim level none until a rendered frame is inspected.
export FERRIX_ANDROID_EVIDENCE=QEMU
exec sh "${FERRIX_ANDROID_HELPER:-/usr/lib/ferrix/ferrix-waydroid.sh}" prepare
