#!/bin/sh
# Start the same Rust product stack used by the Alpine smoke route. This runs
# before ferrix-boot-health.start (OpenRC local.d lexical order).
set -eu

mkdir -p /run/ferrix /run/user/0
chmod 0700 /run/user/0
export XDG_RUNTIME_DIR=/run/user/0
export FERRIX_CORE_SOCKET=/run/ferrix/core.sock

/usr/bin/ferrix-core /etc/ferrix/profile.toml --control none &
core_pid=$!
ready=false
for _ in $(seq 1 200); do
  if [ -S "$FERRIX_CORE_SOCKET" ] && kill -0 "$core_pid" 2>/dev/null; then
    ready=true
    break
  fi
  kill -0 "$core_pid" 2>/dev/null || break
  sleep 0.1
done
[ "$ready" = true ] || {
  printf '%s\n' '{"evidence":"QEMU","event":"product-core-failed"}' > /dev/console
  exit 1
}
printf '%s\n' '{"evidence":"QEMU","event":"product-core-ready","socket":"/run/ferrix/core.sock"}' > /dev/console

# --- Service daemons (ADR-001, 002, 003) ------------------------------------
# Backend selection is a bootstrap decision (never an app's): kernel command
# line `ferrix.telephony=mock|modemmanager` / `ferrix.network=mock|networkmanager`
# wins, then the environment (FERRIX_TELEPHONY_BACKEND / FERRIX_NETWORK_BACKEND
# from /etc/ferrix/backends.env if present), default `mock`. The production
# adapters need ModemManager/NetworkManager running on the system bus and the
# daemons built with the `production` feature; until that is verified in this
# image the default stays mock. There is no mock-control channel on this
# route (--mock-control none): pmos-run attaches no virtio-serial ports.
# /var/lib/ferrix is on the real root filesystem, so stores persist across
# guest reboots (unlike the Alpine smoke guest's tmpfs).
cmdline=$(cat /proc/cmdline 2>/dev/null || true)
[ ! -f /etc/ferrix/backends.env ] || . /etc/ferrix/backends.env
cmdline_value() { printf '%s' "$cmdline" | sed -n "s/.*ferrix\.$1=\([a-z-]*\).*/\1/p"; }
telephony_backend=$(cmdline_value telephony)
[ -n "$telephony_backend" ] || telephony_backend=${FERRIX_TELEPHONY_BACKEND:-mock}
network_backend=$(cmdline_value network)
[ -n "$network_backend" ] || network_backend=${FERRIX_NETWORK_BACKEND:-mock}
case "$telephony_backend" in mock|modemmanager) ;; *) telephony_backend=mock ;; esac
case "$network_backend" in mock|networkmanager) ;; *) network_backend=mock ;; esac
mkdir -p /var/lib/ferrix/telephony /var/lib/ferrix/contacts
chmod 0700 /var/lib/ferrix/telephony /var/lib/ferrix/contacts
export FERRIX_APPD_SOCKET=/run/ferrix/ferrix-appd.sock
export FERRIX_DEFAULT_REGION=US
export FERRIX_TARGET=qemu-aarch64
# supervise NAME CMD...: restart on non-zero exit with backoff, recording it.
supervise() {
  sv_name=$1
  shift
  (
    backoff=1
    while :; do
      "$@" >>/run/ferrix/"$sv_name".log 2>&1 || {
        status=$?
        printf '{"evidence":"QEMU","event":"daemon-restarted","name":"%s","exit":%s,"backoff_s":%s}\n' "$sv_name" "$status" "$backoff" > /dev/console
        sleep "$backoff"
        [ "$backoff" -ge 8 ] || backoff=$((backoff * 2))
        continue
      }
      exit 0
    done
  ) &
}
start_service() {
  ss_name=$1
  ss_backend=$2
  ss_bin=$3
  shift 3
  if [ ! -x "$ss_bin" ]; then
    printf '{"evidence":"QEMU","event":"product-service-missing","name":"%s","binary":"%s"}\n' "$ss_name" "$ss_bin" > /dev/console
    return 0
  fi
  : > /run/ferrix/"$ss_name".log
  supervise "$ss_name" "$ss_bin" "$@"
  printf '{"evidence":"QEMU","event":"product-service-started","name":"%s","backend":"%s"}\n' "$ss_name" "$ss_backend" > /dev/console
}
start_service ferrix-telephonyd "$telephony_backend" /usr/bin/ferrix-telephonyd \
  --backend "$telephony_backend" --profile /etc/ferrix/profile.toml --socket /run/ferrix/telephonyd.sock \
  --mock-control none --appd "$FERRIX_APPD_SOCKET" --data-dir /var/lib/ferrix/telephony
start_service ferrix-networkd "$network_backend" /usr/bin/ferrix-networkd \
  --backend "$network_backend" --profile /etc/ferrix/profile.toml --socket /run/ferrix/networkd.sock \
  --mock-control none --appd "$FERRIX_APPD_SOCKET"
if [ -f /usr/share/ferrix/contacts/mock-contacts.json ]; then
  start_service ferrix-contactsd fixtures /usr/bin/ferrix-contactsd \
    --socket /run/ferrix/contactsd.sock --data-dir /var/lib/ferrix/contacts \
    --appd "$FERRIX_APPD_SOCKET" --fixtures /usr/share/ferrix/contacts/mock-contacts.json
else
  start_service ferrix-contactsd store /usr/bin/ferrix-contactsd \
    --socket /run/ferrix/contactsd.sock --data-dir /var/lib/ferrix/contacts --appd "$FERRIX_APPD_SOCKET"
fi
for _ in $(seq 1 150); do
  [ -S /run/ferrix/telephonyd.sock ] && [ -S /run/ferrix/networkd.sock ] && [ -S /run/ferrix/contactsd.sock ] && break
  sleep 0.1
done
svc_flag() { if [ -S "$1" ]; then printf true; else printf false; fi; }
printf '{"evidence":"QEMU","event":"product-services-ready","telephony":%s,"network":%s,"contacts":%s,"telephony_backend":"%s","network_backend":"%s","data_dir":"/var/lib/ferrix","persistent":true}\n' \
  "$(svc_flag /run/ferrix/telephonyd.sock)" "$(svc_flag /run/ferrix/networkd.sock)" "$(svc_flag /run/ferrix/contactsd.sock)" "$telephony_backend" "$network_backend" > /dev/console
# The daemons' own records (telephonyd-ready, networkd-ready, ...) are
# replayed to the console so the serial log carries them.
for name in ferrix-telephonyd ferrix-networkd ferrix-contactsd; do
  [ -f /run/ferrix/"$name".log ] && cat /run/ferrix/"$name".log > /dev/console || true
done

case " $cmdline " in
  *" ferrix.graphics=on "*) ;;
  *)
    # Headless: ferrix-appd is still the identity authority (ADR-004) for
    # the daemons, without a home surface or autostarted apps.
    if [ -x /usr/bin/ferrix-appd ]; then
      /usr/bin/ferrix-appd --socket "$FERRIX_APPD_SOCKET" --app-dir /usr/share/ferrix/apps --no-autostart \
        >/run/ferrix/ferrix-appd.log 2>&1 &
      for _ in $(seq 1 100); do
        grep -q '"event":"ferrix-appd-ready"' /run/ferrix/ferrix-appd.log 2>/dev/null && break
        sleep 0.1
      done
      cat /run/ferrix/ferrix-appd.log > /dev/console || true
    fi
    exit 0
    ;;
esac

modprobe virtio_gpu 2>/dev/null || true
modprobe virtio_input 2>/dev/null || true
if ! rc-service seatd start >/dev/null 2>&1; then
  seatd -n -g root &
fi
sleep 1
/usr/bin/ferrix-shell --core "$FERRIX_CORE_SOCKET" /etc/ferrix/profile.toml >/run/ferrix/ferrix-shell.log 2>&1 &
shell_pid=$!
for _ in $(seq 1 200); do
  if [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && grep -q '"event":"compositor-ready"' /run/ferrix/ferrix-shell.log 2>/dev/null; then
    break
  fi
  kill -0 "$shell_pid" 2>/dev/null || break
  sleep 0.1
done
[ -S "$XDG_RUNTIME_DIR/wayland-0" ] || {
  cat /run/ferrix/ferrix-shell.log > /dev/console
  exit 1
}
# Waydroid's package manager needs a running Wayland-backed session.  The
# early Android local.d hook can initialize the container but intentionally
# runs before this socket exists.  Provision the already verified, staged APK
# here, before appd begins launching applications.  The session bus and pulse
# socket are owned by this bootstrap, not by an application or appd.
if [ -f /usr/share/ferrix/android/fulguris.apk ] && command -v waydroid >/dev/null 2>&1; then
  export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/ferrix-android-bus
  export PULSE_RUNTIME_PATH=/run/pulse
  rm -f /run/user/0/ferrix-android-bus
  dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork --nopidfile 2>/run/ferrix/android-dbus.log || true
  pulseaudio --system --daemonize=yes --exit-idle-time=-1 >/run/ferrix/android-pulse.log 2>&1 || true
  # Alpine's system PulseAudio daemon owns /run/pulse/native, while Waydroid
  # mounts the compositor user's pulse path.  Make that same socket visible
  # at the session path before starting the container-side hwcomposer.
  for _ in $(seq 1 50); do [ -S /run/pulse/native ] && break; sleep 0.1; done
  if [ -S /run/pulse/native ]; then
    mkdir -p /run/user/0/pulse
    ln -sf /run/pulse/native /run/user/0/pulse/native
  fi
  waydroid session start >/run/ferrix/waydroid-session.log 2>&1 &
  # RUNNING only means the LXC/session processes exist. Package operations
  # require Android's framework to have completed boot as well.
  for _ in $(seq 1 1800); do
    [ "$(waydroid shell -- getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] && break
    sleep 0.1
  done
  provision_status=present
  waydroid shell -- pm path net.slions.fulguris.full.fdroid >/run/ferrix/waydroid-app-list.log 2>&1 || true
  if ! grep -q '^package:' /run/ferrix/waydroid-app-list.log 2>/dev/null; then
    provision_status=installed
    waydroid app install /usr/share/ferrix/android/fulguris.apk >/run/ferrix/waydroid-fulguris-install.log 2>&1 || true
  fi
  for _ in $(seq 1 600); do
    waydroid shell -- pm path net.slions.fulguris.full.fdroid >/run/ferrix/waydroid-app-list.log 2>&1 || true
    grep -q '^package:' /run/ferrix/waydroid-app-list.log 2>/dev/null && break
    sleep 0.1
  done
  if grep -q '^package:' /run/ferrix/waydroid-app-list.log 2>/dev/null; then
    # RoleManager's shell command authorizes Android's shell UID (2000), not
    # the UID 0 used by `waydroid shell`. Run it in the existing container as
    # that UID, then verify the effective HTTPS resolver rather than trusting
    # the command's asynchronous, output-free success response.
    : > /run/ferrix/waydroid-fulguris-role.log
    : > /run/ferrix/waydroid-browser-resolver.log
    waydroid container unfreeze >>/run/ferrix/waydroid-fulguris-role.log 2>&1 || true
    lxc-attach -P /var/lib/waydroid/lxc -n waydroid --uid 2000 -- \
      /system/bin/cmd role add-role-holder android.app.role.BROWSER net.slions.fulguris.full.fdroid \
      >>/run/ferrix/waydroid-fulguris-role.log 2>&1 || true
    for _ in $(seq 1 100); do
      waydroid shell -- cmd package resolve-activity --brief \
        -a android.intent.action.VIEW -c android.intent.category.BROWSABLE \
        -d https://example.com >/run/ferrix/waydroid-browser-resolver.log 2>&1 || true
      grep -q '^net\.slions\.fulguris\.full\.fdroid/' /run/ferrix/waydroid-browser-resolver.log 2>/dev/null && break
      sleep 0.1
    done
    if grep -q '^net\.slions\.fulguris\.full\.fdroid/' /run/ferrix/waydroid-browser-resolver.log 2>/dev/null; then
      printf '{"evidence":"QEMU","event":"android-app-provision","app":"org.ferrix.browser","status":"%s","package":"net.slions.fulguris.full.fdroid","browser_role":"default"}\n' "$provision_status" > /dev/console
    else
      printf '%s\n' '{"evidence":"QEMU","event":"android-app-provision","app":"org.ferrix.browser","status":"failed","reason":"default-browser-role","role_log":"/run/ferrix/waydroid-fulguris-role.log","resolver_log":"/run/ferrix/waydroid-browser-resolver.log"}' > /dev/console
      cat /run/ferrix/waydroid-fulguris-role.log /run/ferrix/waydroid-browser-resolver.log > /dev/console 2>/dev/null || true
    fi
  else
    printf '%s\n' '{"evidence":"QEMU","event":"android-app-provision","app":"org.ferrix.browser","status":"failed","session_log":"/run/ferrix/waydroid-session.log","install_log":"/run/ferrix/waydroid-fulguris-install.log"}' > /dev/console
    printf '%s\n' 'android provisioning diagnostics:' > /dev/console
    waydroid status > /dev/console 2>&1 || true
    for log in /run/ferrix/waydroid-session.log /run/ferrix/waydroid-fulguris-install.log /run/ferrix/android-pulse.log /run/ferrix/android-dbus.log; do
      [ ! -s "$log" ] || { printf '%s\n' "--- $log" > /dev/console; tail -n 40 "$log" > /dev/console; }
    done
  fi
fi
# Application platform: ferrix-appd owns the catalog (/usr/share/ferrix/apps), starts
# every app as a namespaced supervised process via ferrix-sandbox, and
# auto-starts the home surface. Apps inherit this environment.
export HOME=/home/user USER=user SHELL=/bin/sh
export WAYLAND_DISPLAY=wayland-0
export FERRIX_APPD_SOCKET=/run/ferrix/ferrix-appd.sock
/usr/bin/ferrix-appd --socket "$FERRIX_APPD_SOCKET" --app-dir /usr/share/ferrix/apps \
  >/run/ferrix/ferrix-appd.log 2>&1 &
appd_pid=$!
for _ in $(seq 1 100); do
  if [ -S "$FERRIX_APPD_SOCKET" ] && grep -q '"event":"ferrix-appd-ready"' /run/ferrix/ferrix-appd.log 2>/dev/null; then
    break
  fi
  kill -0 "$appd_pid" 2>/dev/null || break
  sleep 0.1
done
grep -q '"event":"ferrix-appd-ready"' /run/ferrix/ferrix-appd.log 2>/dev/null || {
  cat /run/ferrix/ferrix-appd.log > /dev/console
  exit 1
}
for _ in $(seq 1 150); do
  grep -q '"event":"basic-screen-frame"' /run/ferrix/ferrix-appd.log 2>/dev/null && break
  kill -0 "$appd_pid" 2>/dev/null || break
  sleep 0.1
done
grep -q '"event":"basic-screen-frame"' /run/ferrix/ferrix-appd.log || {
  cat /run/ferrix/ferrix-appd.log > /dev/console
  exit 1
}
# The launcher is hit-testable only after home-ready (catalog loaded); wait
# bounded so a first tap is deterministic, and say so if it never came.
for _ in $(seq 1 100); do
  grep -q '"event":"home-ready"' /run/ferrix/ferrix-appd.log 2>/dev/null && break
  sleep 0.1
done
grep -q '"event":"home-ready"' /run/ferrix/ferrix-appd.log 2>/dev/null \
  || printf '%s\n' '{"evidence":"QEMU","event":"product-home-not-ready","reason":"no-home-ready-record"}' > /dev/console
cat /run/ferrix/ferrix-shell.log > /dev/console
cat /run/ferrix/ferrix-appd.log > /dev/console
printf '%s\n' '{"evidence":"QEMU","event":"product-wayland-ready","compositor":"ferrix-shell","client":"ferrix-basic-screen","ferrix-appd":"/run/ferrix/ferrix-appd.sock"}' > /dev/console
