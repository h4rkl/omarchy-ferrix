#!/bin/sh
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mkdir -p /run /etc/omarchy
cp /profile.toml /etc/omarchy/profile.toml
if [ -x /usr/bin/mobile-core ]; then
  /usr/bin/mobile-core /etc/omarchy/profile.toml
else
  printf '%s\n' '{"evidence":"mock","event":"boot-health","status":"ok","profile":"emulator-dev","battery_percent":75,"charging":false}'
fi
printf '%s\n' '{"evidence":"mock","event":"power-changed","battery_percent":75,"charging":true}'
printf '%s\n' '{"evidence":"QEMU","event":"boot-health","status":"ok"}'
if grep -q 'omarchy.graphics=on' /proc/cmdline; then
  export XDG_RUNTIME_DIR=/run/user/0
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
  modprobe virtio_gpu
  modprobe virtio_input
  mkdir -p /run/udev
  /sbin/udevd --daemon
  /sbin/udevadm trigger --action=add
  /sbin/udevadm settle
  # Output geometry. The host launcher may request a window-friendly portrait
  # panel (omarchy.display=WxH); otherwise the profile panel is used. Weston is
  # pinned to exactly this mode because host UI size hints (QEMU's Cocoa
  # window pushes its own size into virtio-gpu) must not change the guest
  # surface. virtio-gpu accepts any mode timing, so a simple modeline suffices.
  display=$(sed -n 's/.*omarchy\.display=\([0-9][0-9]*x[0-9][0-9]*\).*/\1/p' /proc/cmdline)
  display_source=cmdline
  if [ -z "$display" ]; then
    display_w=$(awk -F= '/^[[:space:]]*width[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' /etc/omarchy/profile.toml)
    display_h=$(awk -F= '/^[[:space:]]*height[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' /etc/omarchy/profile.toml)
    display="${display_w}x${display_h}"
    display_source=profile
  fi
  display_w=${display%x*}
  display_h=${display#*x}
  modeline=$(awk -v w="$display_w" -v h="$display_h" 'BEGIN { ht = w + 160; vt = h + 40; printf "%.3f %d %d %d %d %d %d %d %d -hsync +vsync", ht * vt * 60 / 1000000, w, w + 48, w + 80, ht, h, h + 3, h + 8, vt }')
  cat > /etc/omarchy/weston.ini <<EOF
[core]
idle-time=0

[output]
name=Virtual-1
mode=$modeline
EOF
  printf '{"evidence":"QEMU","event":"display-geometry","width":%s,"height":%s,"source":"%s","connector":"Virtual-1"}\n' "$display_w" "$display_h" "$display_source"
  seatd -n -g root &
  sleep 1
  weston --config=/etc/omarchy/weston.ini --backend=drm-backend.so --shell=desktop-shell.so --socket=wayland-0 --continue-without-input --log=/run/weston.log &
  for _ in $(seq 1 50); do
    [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && break
    sleep 0.1
  done
  if [ -S "$XDG_RUNTIME_DIR/wayland-0" ]; then
    WAYLAND_DISPLAY=wayland-0 /usr/bin/mobile-basic-screen /etc/omarchy/profile.toml >/run/mobile-basic-screen.log 2>&1 &
    client_pid=$!
    client_ready=false
    for _ in $(seq 1 100); do
      if grep -q '"event":"basic-screen-frame"' /run/mobile-basic-screen.log 2>/dev/null; then
        client_ready=true
        break
      fi
      kill -0 "$client_pid" 2>/dev/null || break
      sleep 0.1
    done
    if [ "$client_ready" = true ] && kill -0 "$client_pid" 2>/dev/null; then
      cat /run/mobile-basic-screen.log
      tail -n 0 -f /run/mobile-basic-screen.log >/dev/console 2>&1 &
      grep -i 'input\|libinput' /run/weston.log || true
      grep -E 'video modes|preferred|current' /run/weston.log || true
      printf '%s\n' '{"evidence":"QEMU","event":"wayland-ready","compositor":"weston","socket":"wayland-0","client":"mobile-basic-screen"}'
    else
      if kill -0 "$client_pid" 2>/dev/null; then
        printf '%s\n' '{"evidence":"QEMU","event":"wayland-failed","compositor":"weston","reason":"client-connect"}'
      else
        printf '%s\n' '{"evidence":"QEMU","event":"wayland-failed","compositor":"weston","reason":"client-exited"}'
      fi
      cat /run/mobile-basic-screen.log
      cat /run/weston.log
    fi
  else
    printf '%s\n' '{"evidence":"QEMU","event":"wayland-failed","compositor":"weston","reason":"socket"}'
    cat /run/weston.log
  fi
fi
if grep -q 'omarchy.mode=check' /proc/cmdline; then
  poweroff -f
fi
exec /bin/sh
