#!/bin/sh
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /run /etc/omarchy
cp /profile.toml /etc/omarchy/profile.toml
if [ -x /usr/bin/mobile-core ]; then
  /usr/bin/mobile-core /etc/omarchy/profile.toml
else
  printf '%s\n' '{"evidence":"mock","event":"boot-health","status":"ok","profile":"emulator-dev","battery_percent":75,"charging":false}'
fi
printf '%s\n' '{"evidence":"mock","event":"power-changed","battery_percent":75,"charging":true}'
printf '%s\n' '{"evidence":"QEMU","event":"boot-health","status":"ok"}'
if grep -q 'omarchy.graphics=on' /proc/cmdline; then
  export XDG_RUNTIME_DIR=/run/user/0
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
  modprobe virtio_gpu
  seatd -n -g root &
  sleep 1
  weston --backend=drm-backend.so --continue-without-input --log=/run/weston.log &
  for _ in $(seq 1 50); do
    [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && break
    sleep 0.1
  done
  if [ -S "$XDG_RUNTIME_DIR/wayland-0" ]; then
    weston-terminal --fullscreen --shell=/usr/bin/mobile-layout &
    printf '%s\n' '{"evidence":"QEMU","event":"wayland-ready","compositor":"weston","socket":"wayland-0"}'
  else
    printf '%s\n' '{"evidence":"QEMU","event":"wayland-failed","compositor":"weston"}'
    cat /run/weston.log
  fi
fi
if grep -q 'omarchy.mode=check' /proc/cmdline; then
  poweroff -f
fi
exec /bin/sh
