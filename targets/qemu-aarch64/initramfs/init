#!/bin/sh
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mkdir -p /run /run/ferrix /etc/ferrix
cp /profile.toml /etc/ferrix/profile.toml
check_mode=false
grep -q 'ferrix.mode=check' /proc/cmdline && check_mode=true
# Machine-readable boot failure. No success record is ever printed on this
# path; in check mode the guest powers off so the host check fails fast.
boot_failed() {
  printf '{"evidence":"QEMU","event":"boot-failed","reason":"%s"}\n' "$1"
  if [ "$check_mode" = true ]; then
    poweroff -f
  fi
  exec /bin/sh
}
# The persistent Rust mobile core: it owns hardware state (mock adapter for
# this target), serves it on /run/ferrix/core.sock, and takes test commands
# from the host over the virtio-serial port ferrix.control (built into the
# Alpine linux-virt kernel; modprobe is a no-op there).
modprobe virtio_console 2>/dev/null || true
[ -x /usr/bin/mobile-core ] || boot_failed core-missing
# The core writes its JSON records straight to the serial console (no log
# relay, so records are never delayed). It binds the state socket immediately
# before printing boot-health, so a live process plus the socket is readiness.
/usr/bin/mobile-core /etc/ferrix/profile.toml --socket /run/ferrix/core.sock --control auto --shutdown-marker /run/ferrix/shutdown &
core_pid=$!
core_ready=false
for _ in $(seq 1 200); do
  if [ -S /run/ferrix/core.sock ] && kill -0 "$core_pid" 2>/dev/null; then
    core_ready=true
    break
  fi
  kill -0 "$core_pid" 2>/dev/null || break
  sleep 0.1
done
if [ "$core_ready" != true ]; then
  if kill -0 "$core_pid" 2>/dev/null; then
    boot_failed core-not-ready
  else
    boot_failed core-exited
  fi
fi
# Only now is the guest healthy: the core actually reported.
printf '%s\n' '{"evidence":"QEMU","event":"boot-health","status":"ok","core":"mobile-core","socket":"/run/ferrix/core.sock"}'
if grep -q 'ferrix.graphics=on' /proc/cmdline; then
  export XDG_RUNTIME_DIR=/run/user/0
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
  modprobe virtio_gpu
  modprobe virtio_input
  mkdir -p /run/udev
  /sbin/udevd --daemon
  /sbin/udevadm trigger --action=add
  /sbin/udevadm settle
  # Compositor selection. ferrix.shell=mobile-shell starts the Rust product
  # compositor (crates/mobile-shell: Smithay, pixman software rendering into
  # DRM dumb buffers, libinput); ferrix.shell=weston keeps the reference
  # compositor. Default mobile-shell; the host overrides it with FERRIX_QEMU_SHELL.
  shell=$(sed -n 's/.*ferrix\.shell=\([a-z-]*\).*/\1/p' /proc/cmdline)
  case "$shell" in
    mobile-shell|weston) ;;
    *) shell=mobile-shell ;;
  esac
  # Output geometry. The host launcher may request a window-friendly portrait
  # panel (ferrix.display=WxH); otherwise the profile panel is used. Weston is
  # pinned to exactly this mode because host UI size hints (QEMU's Cocoa
  # window pushes its own size into virtio-gpu) must not change the guest
  # surface. virtio-gpu accepts any mode timing, so a simple modeline suffices.
  display=$(sed -n 's/.*ferrix\.display=\([0-9][0-9]*x[0-9][0-9]*\).*/\1/p' /proc/cmdline)
  display_source=cmdline
  if [ -z "$display" ]; then
    display_w=$(awk -F= '/^[[:space:]]*width[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' /etc/ferrix/profile.toml)
    display_h=$(awk -F= '/^[[:space:]]*height[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' /etc/ferrix/profile.toml)
    display="${display_w}x${display_h}"
    display_source=profile
  fi
  display_w=${display%x*}
  display_h=${display#*x}
  modeline=$(awk -v w="$display_w" -v h="$display_h" 'BEGIN { ht = w + 160; vt = h + 40; printf "%.3f %d %d %d %d %d %d %d %d -hsync +vsync", ht * vt * 60 / 1000000, w, w + 48, w + 80, ht, h, h + 3, h + 8, vt }')
  cat > /etc/ferrix/weston.ini <<EOF
[core]
idle-time=0

[output]
name=Virtual-1
mode=$modeline
EOF
  printf '{"evidence":"QEMU","event":"display-geometry","width":%s,"height":%s,"source":"%s","connector":"Virtual-1"}\n' "$display_w" "$display_h" "$display_source"
  seatd -n -g root &
  sleep 1
  comp_pid=
  if [ "$shell" = mobile-shell ]; then
    comp_log=/run/mobile-shell.log
    # mobile-shell reads ferrix.display= itself and pins the DRM mode. Its
    # JSON records (display-geometry, drm-output, input-device,
    # compositor-ready, client-mapped) go to the log and are replayed to the
    # console once the client has drawn; readiness is the socket plus the
    # compositor-ready record, never the process start alone.
    /usr/bin/mobile-shell /etc/ferrix/profile.toml >"$comp_log" 2>&1 &
    comp_pid=$!
    for _ in $(seq 1 150); do
      if [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && grep -q '"event":"compositor-ready"' "$comp_log" 2>/dev/null; then
        break
      fi
      kill -0 "$comp_pid" 2>/dev/null || break
      sleep 0.1
    done
  else
    comp_log=/run/weston.log
    weston --config=/etc/ferrix/weston.ini --backend=drm-backend.so --shell=desktop-shell.so --socket=wayland-0 --continue-without-input --log=/run/weston.log &
    for _ in $(seq 1 50); do
      [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && break
      sleep 0.1
    done
  fi
  if [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && { [ "$shell" = weston ] || grep -q '"event":"compositor-ready"' "$comp_log" 2>/dev/null; }; then
    # Shell environment for the Terminal app's PTY session (BusyBox sh). The
    # kernel starts init with an empty environment, so the client would
    # otherwise have no HOME/USER/SHELL to hand to the spawned shell.
    mkdir -p /root
    hostname ferrix 2>/dev/null || true
    export HOME=/root USER=root SHELL=/bin/sh
    WAYLAND_DISPLAY=wayland-0 /usr/bin/mobile-basic-screen /etc/ferrix/profile.toml --core /run/ferrix/core.sock >/run/mobile-basic-screen.log 2>&1 &
    client_pid=$!
    client_ready=false
    for _ in $(seq 1 100); do
      if grep -q '"event":"basic-screen-frame"' /run/mobile-basic-screen.log 2>/dev/null; then
        client_ready=true
        break
      fi
      kill -0 "$client_pid" 2>/dev/null || break
      sleep 0.1
    done
    if [ "$client_ready" = true ] && kill -0 "$client_pid" 2>/dev/null; then
      cat /run/mobile-basic-screen.log
      tail -n 0 -f /run/mobile-basic-screen.log >/dev/console 2>&1 &
      if [ "$shell" = mobile-shell ]; then
        # Replay the compositor's JSON evidence records and follow new ones
        # (one reader from the start of the log, so nothing is skipped; the
        # tracing lines stay in the log file only).
        tail -n +1 -f "$comp_log" 2>/dev/null | while read -r line; do
          case "$line" in '{'*) printf '%s\n' "$line" ;; esac
        done >/dev/console 2>&1 &
      else
        grep -i 'input\|libinput' /run/weston.log || true
        grep -E 'video modes|preferred|current' /run/weston.log || true
      fi
      printf '{"evidence":"QEMU","event":"wayland-ready","compositor":"%s","socket":"wayland-0","client":"mobile-basic-screen"}\n' "$shell"
    else
      if kill -0 "$client_pid" 2>/dev/null; then
        printf '{"evidence":"QEMU","event":"wayland-failed","compositor":"%s","reason":"client-connect"}\n' "$shell"
      else
        printf '{"evidence":"QEMU","event":"wayland-failed","compositor":"%s","reason":"client-exited"}\n' "$shell"
      fi
      cat /run/mobile-basic-screen.log
      cat "$comp_log"
    fi
  else
    reason=socket
    if [ -n "$comp_pid" ] && ! kill -0 "$comp_pid" 2>/dev/null; then
      reason=compositor-exited
    elif [ "$shell" = mobile-shell ]; then
      reason=compositor-not-ready
    fi
    printf '{"evidence":"QEMU","event":"wayland-failed","compositor":"%s","reason":"%s"}\n' "$shell" "$reason"
    cat "$comp_log"
  fi
fi
if [ "$check_mode" = true ]; then
  # The host drives the check over the mock-control channel and ends it with
  # {"cmd":"shutdown"}; mobile-core leaves this marker. Bounded so a lost host
  # never leaves the guest running forever.
  for _ in $(seq 1 1800); do
    [ -e /run/ferrix/shutdown ] && break
    sleep 0.1
  done
  [ -e /run/ferrix/shutdown ] || printf '%s\n' '{"evidence":"QEMU","event":"check-timeout","reason":"no-shutdown-command"}'
  # Let the core's ack and last records reach the host before power-off.
  sleep 1
  poweroff -f
fi
exec /bin/sh
