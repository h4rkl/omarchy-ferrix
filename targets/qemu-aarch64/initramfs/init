#!/bin/sh
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mkdir -p /run /etc/omarchy
cp /profile.toml /etc/omarchy/profile.toml
if [ -x /usr/bin/mobile-core ]; then
  /usr/bin/mobile-core /etc/omarchy/profile.toml
else
  printf '%s\n' '{"evidence":"mock","event":"boot-health","status":"ok","profile":"emulator-dev","battery_percent":75,"charging":false}'
fi
printf '%s\n' '{"evidence":"mock","event":"power-changed","battery_percent":75,"charging":true}'
printf '%s\n' '{"evidence":"QEMU","event":"boot-health","status":"ok"}'
if grep -q 'omarchy.graphics=on' /proc/cmdline; then
  export XDG_RUNTIME_DIR=/run/user/0
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
  modprobe virtio_gpu
  seatd -n -g root &
  sleep 1
  weston --backend=drm-backend.so --shell=desktop-shell.so --socket=wayland-0 --continue-without-input --log=/run/weston.log &
  for _ in $(seq 1 50); do
    [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && break
    sleep 0.1
  done
  if [ -S "$XDG_RUNTIME_DIR/wayland-0" ]; then
    WAYLAND_DEBUG=1 weston-terminal --fullscreen --shell=/usr/bin/mobile-layout >/run/mobile-layout.log 2>&1 &
    client_pid=$!
    client_ready=false
    for _ in $(seq 1 50); do
      if kill -0 "$client_pid" 2>/dev/null && grep -q 'get_registry' /run/mobile-layout.log; then
        client_ready=true
        break
      fi
      kill -0 "$client_pid" 2>/dev/null || break
      sleep 0.1
    done
    if [ "$client_ready" = true ]; then
      sleep 1
      if kill -0 "$client_pid" 2>/dev/null; then
        printf '%s\n' '{"evidence":"QEMU","event":"wayland-ready","compositor":"weston","socket":"wayland-0","client":"mobile-layout"}'
      else
        printf '%s\n' '{"evidence":"QEMU","event":"wayland-failed","compositor":"weston","reason":"client-exited"}'
        cat /run/mobile-layout.log
        cat /run/weston.log
      fi
    else
      printf '%s\n' '{"evidence":"QEMU","event":"wayland-failed","compositor":"weston","reason":"client-connect"}'
      cat /run/mobile-layout.log
      cat /run/weston.log
    fi
  else
    printf '%s\n' '{"evidence":"QEMU","event":"wayland-failed","compositor":"weston","reason":"socket"}'
    cat /run/weston.log
  fi
fi
if grep -q 'omarchy.mode=check' /proc/cmdline; then
  poweroff -f
fi
exec /bin/sh
