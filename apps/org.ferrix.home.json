{
  "schema_version": 1,
  "id": "org.ferrix.home",
  "runtime": "native",
  "name": "Home",
  "icon": {
    "glyph": "⌂",
    "tone": "neutral"
  },
  "launchable": true,
  "autostart": true,
  "role": "home",
  "trust": "privileged",
  "capabilities": [
    "core-state",
    "core-control",
    "background",
    "telephony-state",
    "network-state",
    "network-control"
  ],
  "launch": {
    "exec": [
      "ferrix-basic-screen"
    ],
    "isolation": {
      "run_dir": {
        "mode": "private-run"
      }
    }
  }
}
