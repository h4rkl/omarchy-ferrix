{
  "schema_version": 1,
  "id": "org.ferrix.terminal",
  "runtime": "native",
  "name": "Terminal",
  "icon": {
    "glyph": ">_",
    "tone": "orange"
  },
  "launchable": true,
  "capabilities": [
    "shell",
    "background",
    "network",
    "files-home"
  ],
  "launch": {
    "exec": [
      "ferrix-terminal"
    ],
    "isolation": {
      "run_dir": {
        "mode": "private-run"
      }
    }
  }
}
