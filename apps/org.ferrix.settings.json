{
  "schema_version": 1,
  "id": "org.ferrix.settings",
  "runtime": "native",
  "name": "Settings",
  "icon": {
    "glyph": "⚙",
    "tone": "blue"
  },
  "launchable": true,
  "capabilities": [
    "network-state",
    "network-control",
    "telephony-state",
    "core-state",
    "core-control"
  ],
  "launch": {
    "exec": [
      "ferrix-settings"
    ],
    "isolation": {
      "run_dir": {
        "mode": "private-run"
      }
    }
  }
}
