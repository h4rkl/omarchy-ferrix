{
  "schema_version": 1,
  "id": "org.ferrix.messages",
  "runtime": "native",
  "name": "Messages",
  "icon": {
    "glyph": "✉",
    "tone": "blue"
  },
  "launchable": true,
  "capabilities": [
    "telephony-state",
    "telephony-sms",
    "contacts-read",
    "background"
  ],
  "intents": [
    "compose"
  ],
  "launch": {
    "exec": [
      "ferrix-messages"
    ],
    "isolation": {
      "run_dir": {
        "mode": "private-run"
      }
    }
  }
}
